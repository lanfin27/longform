  "selections": {},
  "infographic_data": {
    "html_code": "<!DOCTYPE html>\n<html lang=\"ko\">\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <title>금 가격 변동 인포그래픽</title>\n    <link href=\"https://fonts.googleapis.com/css2?family=Nanum+Pen+Script&display=swap\" rel=\"stylesheet\">\n    <link rel=\"stylesheet\" href=\"https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css\">\n    <style>\n        :root {\n            --canvas-width: 1280px;\n            --canvas-height: 720px;\n            --bg: #ffffff;\n            --text: #222222;\n            --red: #ef4444;\n            --green: #22c55e;\n            --blue: #3b82f6;\n            --yellow: #facc15;\n            --purple: #8b5cf6;\n            --orange: #f97316;\n            --gray: #555555;\n            --light-gray: #f5f5f5;\n            --light-pink: #fce4ec;\n            --light-blue: #dbeafe;\n            --light-green: #dcfce7;\n        }\n\n        * { box-sizing: border-box; margin: 0; padding: 0; }\n\n        body {\n            background-color: #e5e7eb;\n            display: flex;\n            flex-direction: column;\n            justify-content: center;\n            align-items: center;\n            min-height: 100vh;\n            font-family: 'Nanum Pen Script', cursive;\n        }\n\n        #video-canvas {\n            width: var(--canvas-width);\n            height: var(--canvas-height);\n            background: #ffffff;\n            position: relative;\n            overflow: hidden;\n            box-shadow: 0 20px 50px rgba(0,0,0,0.2);\n        }\n\n        .scene {\n            display: none;\n            width: 100%;\n            height: 100%;\n            flex-direction: column;\n            justify-content: center;\n            align-items: center;\n            text-align: center;\n            padding: 60px;\n            background: #ffffff;\n        }\n        .scene.active { display: flex; }\n\n        /* 타이포그래피 */\n        h1 { font-size: 84px; line-height: 1.2; margin-bottom: 20px; }\n        h2 { font-size: 64px; line-height: 1.3; margin-bottom: 15px; }\n        p { font-size: 48px; line-height: 1.4; }\n        .text-sm { font-size: 44px; }\n        .text-xs { font-size: 40px; }\n\n        .text-red { color: var(--red); }\n        .text-green { color: var(--green); }\n        .text-blue { color: var(--blue); }\n        .text-gray { color: #757575; }\n\n        /* 하이라이트 */\n        .hl-yellow { background: var(--yellow); padding: 5px 20px; border-radius: 8px; }\n        .hl-pink { background: var(--light-pink); padding: 5px 20px; border-radius: 8px; }\n\n        /* 박스 디자인 - 줄바꿈 방지 */\n        .box, .box-gray, .box-pink, .box-blue, .box-green {\n            border: 4px solid var(--text);\n            border-radius: 16px;\n            padding: 30px 45px;\n            background: white;\n            filter: url(#rough-edge);\n            white-space: nowrap;\n            width: auto;\n            min-width: fit-content;\n            max-width: 90%;\n            font-size: 52px;\n        }\n        .box-gray { background: var(--light-gray); }\n        .box-pink { background: var(--light-pink); }\n        .box-blue { background: var(--light-blue); }\n        .box-green { background: var(--light-green); }\n\n        /* 차트 요소 */\n        .bar {\n            background: var(--gray);\n            border: 3px solid var(--text);\n            border-radius: 8px;\n            filter: url(#rough-strong);\n        }\n        .bar-red { background: var(--red); }\n        .bar-green { background: var(--green); }\n        .bar-blue { background: var(--blue); }\n\n        .gauge-track {\n            width: 80%;\n            height: 50px;\n            background: var(--light-gray);\n            border: 4px solid var(--text);\n            border-radius: 25px;\n            overflow: hidden;\n            filter: url(#rough-edge);\n        }\n        .gauge-fill {\n            height: 100%;\n            filter: url(#rough-strong);\n        }\n\n        .line-chart-container {\n            position: relative;\n            width: 600px;\n            height: 300px;\n            border-left: 4px solid var(--text);\n            border-bottom: 4px solid var(--text);\n            overflow: hidden;\n            margin: 20px 0;\n        }\n\n        /* 애니메이션 */\n        @keyframes float { 0%, 100% { transform: translateY(0); } 50% { transform: translateY(-15px); } }\n        @keyframes pulse { 0%, 100% { transform: scale(1); } 50% { transform: scale(1.05); } }\n        @keyframes blink { 0%, 100% { opacity: 1; } 50% { opacity: 0.3; } }\n        .animate-float { animation: float 3s ease-in-out infinite; }\n        .animate-pulse { animation: pulse 2s ease-in-out infinite; }\n        .animate-blink { animation: blink 1.5s ease-in-out infinite; }\n\n        /* 하단 컨트롤러 */\n        .controls {\n            margin-top: 20px;\n            display: flex;\n            gap: 20px;\n            align-items: center;\n        }\n        button {\n            padding: 10px 20px;\n            font-size: 24px;\n            cursor: pointer;\n            font-family: inherit;\n        }\n    </style>\n</head>\n<body>\n\n    <svg style=\"position: absolute; width: 0; height: 0;\">\n        <filter id=\"rough-edge\">\n            <feTurbulence type=\"fractalNoise\" baseFrequency=\"0.04\" numOctaves=\"5\" result=\"noise\" />\n            <feDisplacementMap in=\"SourceGraphic\" in2=\"noise\" scale=\"3\" />\n        </filter>\n        <filter id=\"rough-strong\">\n            <feTurbulence type=\"fractalNoise\" baseFrequency=\"0.03\" numOctaves=\"3\" result=\"noise\" />\n            <feDisplacementMap in=\"SourceGraphic\" in2=\"noise\" scale=\"5\" />\n        </filter>\n    </svg>\n\n    <div id=\"video-canvas\">\n        \n        <!-- 씬 55: 세계 경제 불확실성 -->\n        <div class=\"scene active\" id=\"scene55\">\n            <h1 class=\"animate-pulse\">세계 경제 불확실성</h1>\n            <div style=\"display: flex; gap: 40px; align-items: center;\">\n                <i class=\"fa-solid fa-earth-americas animate-float\" style=\"font-size: 150px; color: var(--blue);\"></i>\n                <i class=\"fa-solid fa-triangle-exclamation animate-blink\" style=\"font-size: 100px; color: var(--red);\"></i>\n            </div>\n            <div class=\"box-pink\" style=\"margin-top: 40px;\">국가별 전략적 판단 필요</div>\n        </div>\n\n        <!-- 씬 56: 국가 상징과 금괴 -->\n        <div class=\"scene\" id=\"scene56\">\n            <h2>국가 자산의 안전핀</h2>\n            <div style=\"display: flex; gap: 30px; align-items: flex-end; height: 250px;\">\n                <div style=\"text-align: center;\">\n                    <i class=\"fa-solid fa-flag\" style=\"font-size: 60px; margin-bottom: 10px;\"></i>\n                    <div class=\"bar\" style=\"width: 100px; height: 180px; background: var(--gray);\"></div>\n                    <p class=\"text-xs\">일반 자산</p>\n                </div>\n                <div style=\"text-align: center;\">\n                    <i class=\"fa-solid fa-coins\" style=\"font-size: 80px; color: var(--yellow); margin-bottom: 10px;\"></i>\n                    <div class=\"bar\" style=\"width: 120px; height: 220px; background: var(--yellow);\"></div>\n                    <p class=\"text-xs text-orange\">금 비축량</p>\n                </div>\n            </div>\n        </div>\n\n        <!-- 씬 57: 신중함과 선견지명 -->\n        <div class=\"scene\" id=\"scene57\">\n            <div style=\"display: flex; gap: 40px;\">\n                <div class=\"box-gray\" style=\"text-align: center;\">\n                    <i class=\"fa-solid fa-shield-halved\" style=\"font-size: 80px; margin-bottom: 20px;\"></i>\n                    <p>경제적 신중함</p>\n                </div>\n                <div class=\"box-blue\" style=\"text-align: center;\">\n                    <i class=\"fa-solid fa-eye\" style=\"font-size: 80px; margin-bottom: 20px;\"></i>\n                    <p>전략적 선견지명</p>\n                </div>\n            </div>\n        </div>\n\n        <!-- 씬 85: 거대한 변화의 문 -->\n        <div class=\"scene\" id=\"scene85\">\n            <p class=\"text-gray\" style=\"margin-bottom: 20px;\">새로운 국면의 시작</p>\n            <i class=\"fa-solid fa-door-open animate-float\" style=\"font-size: 200px; color: var(--gray);\"></i>\n            <h1 style=\"margin-top: 30px;\"><span class=\"text-orange\">거대한 반전</span></h1>\n        </div>\n\n        <!-- 씬 86: 황금빛 서막 -->\n        <div class=\"scene\" id=\"scene86\">\n            <div style=\"position: relative; width: 300px; height: 300px;\">\n                <div class=\"animate-pulse\" style=\"position: absolute; width: 100%; height: 100%; background: radial-gradient(circle, var(--yellow) 0%, transparent 70%); border-radius: 50%; opacity: 0.6;\"></div>\n                <i class=\"fa-solid fa-vault\" style=\"font-size: 150px; position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%);\"></i>\n            </div>\n            <h2 style=\"margin-top: 20px;\">금고 문이 열리다</h2>\n        </div>\n\n        <!-- 씬 87: 미스터리한 문양/암시 -->\n        <div class=\"scene\" id=\"scene87\">\n            <div class=\"box\" style=\"padding: 60px;\">\n                <i class=\"fa-solid fa-fingerprint\" style=\"font-size: 100px; margin-bottom: 20px;\"></i>\n                <h1>시장의 숨겨진 신호</h1>\n            </div>\n        </div>\n\n        <!-- 씬 106: 달러 상승 vs 금 하락 -->\n        <div class=\"scene\" id=\"scene106\">\n            <h2>자산 가치의 엇갈림</h2>\n            <div style=\"display: flex; gap: 100px; align-items: flex-end; height: 300px;\">\n                <div style=\"text-align: center;\">\n                    <h1 class=\"text-green\">↑</h1>\n                    <div class=\"bar bar-green animate-float\" style=\"width: 120px; height: 250px;\"></div>\n                    <p style=\"font-size: 60px;\">달러($)</p>\n                </div>\n                <div style=\"text-align: center;\">\n                    <h1 class=\"text-red\">↓</h1>\n                    <div class=\"bar bar-red\" style=\"width: 120px; height: 100px;\"></div>\n                    <p style=\"font-size: 60px;\">금(Gold)</p>\n                </div>\n            </div>\n        </div>\n\n        <!-- 씬 107: 시장의 공포 (매도 주문) -->\n        <div class=\"scene\" id=\"scene107\">\n            <h1 class=\"text-red animate-blink\">시장의 공포(Panic)</h1>\n            <div style=\"display: flex; gap: 20px; flex-wrap: wrap; justify-content: center; width: 80%;\">\n                <div class=\"box-pink\" style=\"font-size: 36px;\">SELL GOLD</div>\n                <div class=\"box-pink\" style=\"font-size: 36px;\">SELL GOLD</div>\n                <div class=\"box-pink\" style=\"font-size: 36px;\">SELL GOLD</div>\n                <div class=\"box-pink\" style=\"font-size: 36px;\">SELL GOLD</div>\n            </div>\n            <p style=\"margin-top: 30px;\">매도 물량 폭주</p>\n        </div>\n\n        <!-- 씬 108: 주식 차트와 디지털 인터페이스 -->\n        <div class=\"scene\" id=\"scene108\">\n            <div class=\"line-chart-container\">\n                <svg width=\"100%\" height=\"100%\" style=\"position: absolute;\">\n                    <polyline points=\"30,50 150,80 300,200 450,250 570,280\" \n                              stroke=\"#ef4444\" stroke-width=\"8\" fill=\"none\" \n                              style=\"filter: url(#rough-edge);\"/>\n                </svg>\n                <div style=\"position: absolute; right: 20px; bottom: 20px;\" class=\"text-red\">CRASH</div>\n            </div>\n            <h2>패닉 셀링의 가속화</h2>\n        </div>\n\n        <!-- 씬 115: 알고리즘의 지배 -->\n        <div class=\"scene\" id=\"scene115\">\n            <h2 class=\"text-blue\">자동화된 알고리즘</h2>\n            <div style=\"display: flex; gap: 30px; align-items: center;\">\n                <i class=\"fa-solid fa-microchip\" style=\"font-size: 100px; color: var(--blue);\"></i>\n                <i class=\"fa-solid fa-arrow-right\" style=\"font-size: 50px;\"></i>\n                <i class=\"fa-solid fa-robot animate-float\" style=\"font-size: 100px; color: var(--gray);\"></i>\n            </div>\n            <p style=\"margin-top: 30px;\">인간의 감정이 배제된 거래</p>\n        </div>\n\n        <!-- 씬 116: 초고속 데이터 스트림 -->\n        <div class=\"scene\" id=\"scene116\">\n            <div class=\"gauge-track\" style=\"width: 70%; height: 80px;\">\n                <div class=\"gauge-fill animate-blink\" style=\"width: 100%; background: linear-gradient(90deg, var(--blue), var(--purple));\"></div>\n            </div>\n            <h1 style=\"margin-top: 30px;\">초당 100만 건 처리</h1>\n        </div>\n\n        <!-- 씬 117: 디지털 회로 시각화 -->\n        <div class=\"scene\" id=\"scene117\">\n            <div style=\"display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px;\">\n                <div class=\"box-blue\"><i class=\"fa-solid fa-code\"></i></div>\n                <div class=\"box-blue\"><i class=\"fa-solid fa-network-wired\"></i></div>\n                <div class=\"box-blue\"><i class=\"fa-solid fa-server\"></i></div>\n            </div>\n            <p style=\"margin-top: 30px;\">기술적 매도 신호 포착</p>\n        </div>\n\n        <!-- 씬 118: 도미노 효과 (손절매) -->\n        <div class=\"scene\" id=\"scene118\">\n            <h2>연쇄적인 손절매(Stop-loss)</h2>\n            <div style=\"display: flex; gap: 15px; align-items: flex-end;\">\n                <div style=\"width: 40px; height: 150px; background: var(--red); transform: rotate(20deg); border: 2px solid #000;\"></div>\n                <div style=\"width: 40px; height: 150px; background: var(--red); transform: rotate(45deg); border: 2px solid #000;\"></div>\n                <div style=\"width: 40px; height: 150px; background: var(--red); transform: rotate(70deg); border: 2px solid #000;\"></div>\n                <div style=\"width: 150px; height: 40px; background: var(--red); border: 2px solid #000;\"></div>\n            </div>\n            <p class=\"text-red\" style=\"margin-top: 40px;\">도미노처럼 무너지는 가격</p>\n        </div>\n\n        <!-- 씬 119: 강제 청산의 파편 -->\n        <div class=\"scene\" id=\"scene119\">\n            <h1 class=\"text-red\">레버리지 ETF 강제 청산</h1>\n            <div style=\"display: flex; gap: 20px; margin-top: 30px;\">\n                <i class=\"fa-solid fa-burst animate-pulse\" style=\"font-size: 120px; color: var(--orange);\"></i>\n                <div class=\"box-pink\">담보 부족!</div>\n            </div>\n        </div>\n\n        <!-- 씬 120: 시장 카오스 -->\n        <div class=\"scene\" id=\"scene120\">\n            <div class=\"box\" style=\"border-color: var(--red); color: var(--red);\">\n                <i class=\"fa-solid fa-skull-crossbones\"></i> CHAOS\n            </div>\n            <h2 style=\"margin-top: 30px;\">예측 범위를 벗어난 급락</h2>\n        </div>\n\n        <!-- 씬 139: 글로벌 리스크 복합 시각화 -->\n        <div class=\"scene\" id=\"scene139\">\n            <h2>글로벌 위기 리스트</h2>\n            <div style=\"display: flex; gap: 30px;\">\n                <div class=\"box-gray text-xs\">재정 적자 폭발</div>\n                <div class=\"box-gray text-xs\">지정학적 리스크</div>\n                <div class=\"box-gray text-xs\">달러 신뢰 하락</div>\n            </div>\n        </div>\n\n        <!-- 씬 140: 건강한 조정 (강세장 그래프) -->\n        <div class=\"scene\" id=\"scene140\">\n            <h2 class=\"text-green\">장기 강세 속의 '건강한 조정'</h2>\n            <div class=\"line-chart-container\">\n                <svg width=\"100%\" height=\"100%\" style=\"position: absolute;\">\n                    <polyline points=\"30,250 150,180 250,220 350,100 500,50\" \n                              stroke=\"#22c55e\" stroke-width=\"10\" fill=\"none\"\n                              style=\"filter: url(#rough-edge);\"/>\n                </svg>\n                <div class=\"data-point animate-pulse\" style=\"left: 242px; top: 212px; width: 16px; height: 16px; background: var(--orange); border-radius: 50%; position: absolute;\"></div>\n                <p style=\"position: absolute; left: 265px; top: 220px;\" class=\"text-xs text-orange\">현재 지점</p>\n            </div>\n        </div>\n\n        <!-- 씬 141: 전문가의 낙관적 전망 -->\n        <div class=\"scene\" id=\"scene141\">\n            <div class=\"box-green\">\n                <h1>\"오히려 매수 기회입니다\"</h1>\n            </div>\n            <p style=\"margin-top: 30px;\">불안 속에서 찾는 장기 가치</p>\n        </div>\n\n        <!-- 씬 163: 저울 - 화폐 vs 금 -->\n        <div class=\"scene\" id=\"scene163\">\n            <div style=\"display: flex; gap: 100px; align-items: center;\">\n                <div style=\"text-align: center;\">\n                    <i class=\"fa-solid fa-money-bill-1\" style=\"font-size: 100px; color: var(--green);\"></i>\n                    <p>종이 화폐</p>\n                </div>\n                <div style=\"font-size: 80px;\">⚖️</div>\n                <div style=\"text-align: center;\">\n                    <i class=\"fa-solid fa-gold-bar\" style=\"font-size: 100px; color: var(--yellow);\"></i>\n                    <p>실물 금</p>\n                </div>\n            </div>\n            <h2 style=\"margin-top: 40px;\">근본적 가치에 대한 질문</h2>\n        </div>\n\n        <!-- 씬 164: 디지털 vs 클래식 -->\n        <div class=\"scene\" id=\"scene164\">\n            <div style=\"display: flex; gap: 40px;\">\n                <div class=\"box-blue\" style=\"opacity: 0.6;\">디지털 숫자</div>\n                <div style=\"font-size: 50px; margin-top: 10px;\">VS</div>\n                <div class=\"box-yellow\">영원한 광택</div>\n            </div>\n            <p style=\"margin-top: 30px;\">금융 시스템에 대한 고찰</p>\n        </div>\n\n        <!-- 씬 165: 가치의 재발견 -->\n        <div class=\"scene\" id=\"scene165\">\n            <p class=\"text-gray\">불확실한 시대, 우리의 선택은?</p>\n            <h1 class=\"animate-pulse\"><span class=\"hl-yellow\">금의 가치는 변하지 않는다</span></h1>\n            <i class=\"fa-solid fa-gem\" style=\"font-size: 120px; color: var(--blue); margin-top: 30px;\"></i>\n        </div>\n\n    </div>\n\n    <div class=\"controls\">\n        <button onclick=\"move(-1)\">이전 (←)</button>\n        <p><span id=\"current-idx\">1</span> / <span id=\"total-scenes\">21</span></p>\n        <button onclick=\"move(1)\">다음 (→)</button>\n    </div>\n\n    <script>\n        let currentIdx = 0;\n        const scenes = document.querySelectorAll('.scene');\n        const counterText = document.getElementById('current-idx');\n        const totalText = document.getElementById('total-scenes');\n\n        if (totalText) totalText.innerText = scenes.length;\n\n        function update() {\n            scenes.forEach((s, i) => s.classList.toggle('active', i === currentIdx));\n            counterText.innerText = currentIdx + 1;\n        }\n\n        function move(n) {\n            currentIdx += n;\n            if (currentIdx < 0) currentIdx = 0;\n            if (currentIdx >= scenes.length) currentIdx = scenes.length - 1;\n            update();\n        }\n\n        document.addEventListener('keydown', (e) => {\n            if (e.key === 'ArrowRight') move(1);\n            if (e.key === 'ArrowLeft') move(-1);\n        });\n\n        update();\n    </script>\n</body>\n</html>",
