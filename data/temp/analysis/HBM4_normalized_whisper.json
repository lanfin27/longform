[
  {
    "scene_id": 1,
    "text": "여러분은 반도치하면 뭐가 떠오르세요?",
    "start_time": 0.0,
    "end_time": 1.82,
    "duration": 1.82,
    "timecode": "00:00:00,000 --> 00:00:01,820",
    "is_recovered": false
  },
  {
    "scene_id": 2,
    "text": "삼성, SK, 아니면 엔비디아",
    "start_time": 2.259,
    "end_time": 4.98,
    "duration": 2.7210000000000005,
    "timecode": "00:00:02,258 --> 00:00:04,980",
    "is_recovered": false
  },
  {
    "scene_id": 3,
    "text": "근데요, 지금 이 회사들이 목숨 걸고 싸우는게 뭔지 아세요?",
    "start_time": 4.98,
    "end_time": 8.519,
    "duration": 3.5389999999999997,
    "timecode": "00:00:04,980 --> 00:00:08,519",
    "is_recovered": false
  },
  {
    "scene_id": 4,
    "text": "메모리에요",
    "start_time": 8.96,
    "end_time": 9.58,
    "duration": 0.6199999999999992,
    "timecode": "00:00:08,960 --> 00:00:09,580",
    "is_recovered": false
  },
  {
    "scene_id": 5,
    "text": "근데 그냥 메모리가 아니에요",
    "start_time": 9.58,
    "end_time": 10.9,
    "duration": 1.3200000000000003,
    "timecode": "00:00:09,580 --> 00:00:10,900",
    "is_recovered": false
  },
  {
    "scene_id": 6,
    "text": "HBM이라고 AI의 심장에 들어가는 초고속 메모리에요",
    "start_time": 12.16,
    "end_time": 15.9,
    "duration": 3.74,
    "timecode": "00:00:12,160 --> 00:00:15,900",
    "is_recovered": false
  },
  {
    "scene_id": 7,
    "text": "2016년, 이 시장 규모가 얼마냐면요?",
    "start_time": 15.9,
    "end_time": 19.179,
    "duration": 3.278999999999998,
    "timecode": "00:00:15,900 --> 00:00:19,178",
    "is_recovered": false
  },
  {
    "scene_id": 8,
    "text": "무려 78조 원이에요",
    "start_time": 19.3,
    "end_time": 20.46,
    "duration": 1.1600000000000001,
    "timecode": "00:00:19,300 --> 00:00:20,460",
    "is_recovered": false
  },
  {
    "scene_id": 9,
    "text": "근데 이게 왜 중요하냐?",
    "start_time": 20.46,
    "end_time": 21.98,
    "duration": 1.5199999999999996,
    "timecode": "00:00:20,460 --> 00:00:21,980",
    "is_recovered": false
  },
  {
    "scene_id": 10,
    "text": "지금부터 제가 하는 얘기 끝까지 들으시면요",
    "start_time": 22.019,
    "end_time": 24.719,
    "duration": 2.700000000000003,
    "timecode": "00:00:22,018 --> 00:00:24,719",
    "is_recovered": false
  },
  {
    "scene_id": 11,
    "text": "삼성이랑 SK하이닉스가 왜 이 시장에서 피터지게 싸우는지",
    "start_time": 24.719,
    "end_time": 28.62,
    "duration": 3.901,
    "timecode": "00:00:24,719 --> 00:00:28,620",
    "is_recovered": false
  },
  {
    "scene_id": 12,
    "text": "그리고 이게 여러분 투자의 어떤 의미인지 완전히 이해하시게 될 거예요",
    "start_time": 28.62,
    "end_time": 32.52,
    "duration": 3.900000000000002,
    "timecode": "00:00:28,620 --> 00:00:32,520",
    "is_recovered": false
  },
  {
    "scene_id": 13,
    "text": "자, 시작해 볼게요",
    "start_time": 32.52,
    "end_time": 34.079,
    "duration": 1.5589999999999975,
    "timecode": "00:00:32,520 --> 00:00:34,079",
    "is_recovered": false
  },
  {
    "scene_id": 14,
    "text": "HBM이 뭔지 아시는 분 계세요?",
    "start_time": 34.079,
    "end_time": 36.38,
    "duration": 2.301000000000002,
    "timecode": "00:00:34,079 --> 00:00:36,380",
    "is_recovered": false
  },
  {
    "scene_id": 15,
    "text": "하이밴드위트 메모리의 약자에요",
    "start_time": 36.84,
    "end_time": 38.579,
    "duration": 1.7389999999999972,
    "timecode": "00:00:36,840 --> 00:00:38,579",
    "is_recovered": false
  },
  {
    "scene_id": 16,
    "text": "우리말로 하면 고대역폭 메모리인데요",
    "start_time": 38.579,
    "end_time": 40.7,
    "duration": 2.121000000000002,
    "timecode": "00:00:38,579 --> 00:00:40,700",
    "is_recovered": false
  },
  {
    "scene_id": 17,
    "text": "쉽게 말해서 엄청 빠른 메모리에요",
    "start_time": 40.7,
    "end_time": 43.039,
    "duration": 2.3389999999999986,
    "timecode": "00:00:40,700 --> 00:00:43,039",
    "is_recovered": false
  },
  {
    "scene_id": 18,
    "text": "근데 왜 이게 필요하냐?",
    "start_time": 43.039,
    "end_time": 44.42,
    "duration": 1.3810000000000002,
    "timecode": "00:00:43,039 --> 00:00:44,420",
    "is_recovered": false
  },
  {
    "scene_id": 19,
    "text": "여러분 채찌 PT 써보셨죠?",
    "start_time": 44.539,
    "end_time": 46.159,
    "duration": 1.6199999999999974,
    "timecode": "00:00:44,539 --> 00:00:46,158",
    "is_recovered": false
  },
  {
    "scene_id": 20,
    "text": "이거 돌리려면 엔비디아 GPU가 필요한데요",
    "start_time": 46.42,
    "end_time": 48.659,
    "duration": 2.238999999999997,
    "timecode": "00:00:46,420 --> 00:00:48,658",
    "is_recovered": false
  },
  {
    "scene_id": 21,
    "text": "이 GPU가 아무리 빨라봤자",
    "start_time": 48.659,
    "end_time": 50.539,
    "duration": 1.8800000000000026,
    "timecode": "00:00:48,658 --> 00:00:50,539",
    "is_recovered": false
  },
  {
    "scene_id": 22,
    "text": "메모리가 느리면 소용없어요",
    "start_time": 50.539,
    "end_time": 52.82,
    "duration": 2.280999999999999,
    "timecode": "00:00:50,539 --> 00:00:52,820",
    "is_recovered": false
  },
  {
    "scene_id": 23,
    "text": "이걸 전문용어로 메모리 벽이라고 하거든요",
    "start_time": 52.82,
    "end_time": 54.96,
    "duration": 2.1400000000000006,
    "timecode": "00:00:52,820 --> 00:00:54,960",
    "is_recovered": false
  },
  {
    "scene_id": 24,
    "text": "아무리 빠른 두뇌가 있어도",
    "start_time": 54.96,
    "end_time": 56.759,
    "duration": 1.7989999999999995,
    "timecode": "00:00:54,960 --> 00:00:56,759",
    "is_recovered": false
  },
  {
    "scene_id": 25,
    "text": "근데 정보가 제때 안 들어오면 멍 때리는 거예요",
    "start_time": 56.759,
    "end_time": 59.32,
    "duration": 2.561,
    "timecode": "00:00:56,759 --> 00:00:59,320",
    "is_recovered": false
  },
  {
    "scene_id": 26,
    "text": "그래서 2013년에 업계가 뭘 했었냐면요",
    "start_time": 59.32,
    "end_time": 63.06,
    "duration": 3.740000000000002,
    "timecode": "00:00:59,320 --> 00:01:03,060",
    "is_recovered": false
  },
  {
    "scene_id": 27,
    "text": "DRAM 칩을 옆으로 늘리지 말고 위로 쌓자",
    "start_time": 63.06,
    "end_time": 65.9,
    "duration": 2.8400000000000034,
    "timecode": "00:01:03,060 --> 00:01:05,900",
    "is_recovered": false
  },
  {
    "scene_id": 28,
    "text": "이렇게 해서 나온 게 HBM이에요",
    "start_time": 65.9,
    "end_time": 68.92,
    "duration": 3.019999999999996,
    "timecode": "00:01:05,900 --> 00:01:08,920",
    "is_recovered": false
  },
  {
    "scene_id": 29,
    "text": "칩을 8개, 12개, 16개씩 수직으로 쌓아서",
    "start_time": 69.42,
    "end_time": 72.64,
    "duration": 3.219999999999999,
    "timecode": "00:01:09,420 --> 00:01:12,640",
    "is_recovered": false
  },
  {
    "scene_id": 30,
    "text": "한 번에 엄청난 데이터를 주고 받는 거죠",
    "start_time": 72.64,
    "end_time": 74.819,
    "duration": 2.179000000000002,
    "timecode": "00:01:12,640 --> 00:01:14,819",
    "is_recovered": false
  },
  {
    "scene_id": 31,
    "text": "근데요",
    "start_time": 75.4,
    "end_time": 75.859,
    "duration": 0.458999999999989,
    "timecode": "00:01:15,400 --> 00:01:15,858",
    "is_recovered": false
  },
  {
    "scene_id": 32,
    "text": "2020년에 채찌 PT가 터지면서 상황이 완전 달라졌어요",
    "start_time": 76.939,
    "end_time": 80.48,
    "duration": 3.541000000000011,
    "timecode": "00:01:16,938 --> 00:01:20,480",
    "is_recovered": false
  },
  {
    "scene_id": 33,
    "text": "AI 수요가 폭발하니까",
    "start_time": 80.48,
    "end_time": 82.15899999999999,
    "duration": 1.6789999999999878,
    "timecode": "00:01:20,480 --> 00:01:22,158",
    "is_recovered": false
  },
  {
    "scene_id": 34,
    "text": "HBM 시장도 미친 듯이 커진 거예요",
    "start_time": 82.15899999999999,
    "end_time": 84.78,
    "duration": 2.6210000000000093,
    "timecode": "00:01:22,158 --> 00:01:24,780",
    "is_recovered": false
  },
  {
    "scene_id": 35,
    "text": "불과 3년 만에 10배 이상 성장했어요",
    "start_time": 85.28999999999999,
    "end_time": 87.519,
    "duration": 2.2290000000000134,
    "timecode": "00:01:25,289 --> 00:01:27,519",
    "is_recovered": false
  },
  {
    "scene_id": 36,
    "text": "바로 이게 지금 전쟁의 시작점이에요",
    "start_time": 87.519,
    "end_time": 89.85900000000001,
    "duration": 2.3400000000000034,
    "timecode": "00:01:27,519 --> 00:01:29,859",
    "is_recovered": false
  },
  {
    "scene_id": 37,
    "text": "여기서 끝이 아니에요",
    "start_time": 90.35900000000001,
    "end_time": 91.42,
    "duration": 1.0609999999999928,
    "timecode": "00:01:30,359 --> 00:01:31,420",
    "is_recovered": false
  },
  {
    "scene_id": 38,
    "text": "HBM 4가 나오면서 게임의 룰이 완전히 바뀌었거든요",
    "start_time": 91.42,
    "end_time": 95.34,
    "duration": 3.9200000000000017,
    "timecode": "00:01:31,420 --> 00:01:35,340",
    "is_recovered": false
  },
  {
    "scene_id": 39,
    "text": "자 HBM 4가 뭐가 다른지 설명해 드릴게요",
    "start_time": 95.34,
    "end_time": 98.799,
    "duration": 3.459000000000003,
    "timecode": "00:01:35,340 --> 00:01:38,799",
    "is_recovered": false
  },
  {
    "scene_id": 40,
    "text": "이게 진짜 핵심이에요",
    "start_time": 98.799,
    "end_time": 100.28,
    "duration": 1.4809999999999945,
    "timecode": "00:01:38,799 --> 00:01:40,280",
    "is_recovered": false
  },
  {
    "scene_id": 41,
    "text": "집중하셔야 해요",
    "start_time": 100.28,
    "end_time": 101.47999999999999,
    "duration": 1.1999999999999886,
    "timecode": "00:01:40,280 --> 00:01:41,479",
    "is_recovered": false
  },
  {
    "scene_id": 42,
    "text": "기존 HBM 3 이까지는 인터페이스 폭이 1214 비트였어요",
    "start_time": 101.47999999999999,
    "end_time": 105.07900000000001,
    "duration": 3.599000000000018,
    "timecode": "00:01:41,479 --> 00:01:45,079",
    "is_recovered": false
  },
  {
    "scene_id": 43,
    "text": "근데 HBM 4는요",
    "start_time": 105.07900000000001,
    "end_time": 106.92,
    "duration": 1.840999999999994,
    "timecode": "00:01:45,079 --> 00:01:46,920",
    "is_recovered": false
  },
  {
    "scene_id": 44,
    "text": "2048 비트예요",
    "start_time": 106.92,
    "end_time": 108.34,
    "duration": 1.4200000000000017,
    "timecode": "00:01:46,920 --> 00:01:48,340",
    "is_recovered": false
  },
  {
    "scene_id": 45,
    "text": "두 배로 늘린 거예요",
    "start_time": 108.34,
    "end_time": 109.15899999999999,
    "duration": 0.8189999999999884,
    "timecode": "00:01:48,340 --> 00:01:49,158",
    "is_recovered": false
  },
  {
    "scene_id": 46,
    "text": "이게 뭔 소리냐면요",
    "start_time": 109.15899999999999,
    "end_time": 110.62,
    "duration": 1.4610000000000127,
    "timecode": "00:01:49,158 --> 00:01:50,620",
    "is_recovered": false
  },
  {
    "scene_id": 47,
    "text": "고속도로 차선을 4차선 해서 8차선으로 늘린 거랑 같아요",
    "start_time": 110.62,
    "end_time": 114.06,
    "duration": 3.4399999999999977,
    "timecode": "00:01:50,620 --> 00:01:54,060",
    "is_recovered": false
  },
  {
    "scene_id": 48,
    "text": "같은 시간에 두 배 많은 차가 지나갈 수 있는 거죠",
    "start_time": 114.06,
    "end_time": 116.84,
    "duration": 2.780000000000001,
    "timecode": "00:01:54,060 --> 00:01:56,840",
    "is_recovered": false
  },
  {
    "scene_id": 49,
    "text": "숫자로 보면 더 명확해요",
    "start_time": 117.37899999999999,
    "end_time": 118.959,
    "duration": 1.5800000000000125,
    "timecode": "00:01:57,378 --> 00:01:58,959",
    "is_recovered": false
  },
  {
    "scene_id": 50,
    "text": "HBM 3",
    "start_time": 118.959,
    "end_time": 120.019,
    "duration": 1.0600000000000023,
    "timecode": "00:01:58,959 --> 00:02:00,019",
    "is_recovered": false
  },
  {
    "scene_id": 51,
    "text": "이 최대 대역 폭이 1점",
    "start_time": 120.019,
    "end_time": 121.659,
    "duration": 1.6400000000000006,
    "timecode": "00:02:00,019 --> 00:02:01,659",
    "is_recovered": false
  },
  {
    "scene_id": 52,
    "text": "이 테라바이트였거든요",
    "start_time": 121.659,
    "end_time": 122.739,
    "duration": 1.0799999999999983,
    "timecode": "00:02:01,659 --> 00:02:02,739",
    "is_recovered": false
  },
  {
    "scene_id": 53,
    "text": "무려 쌈 테라바이트까지 가요",
    "start_time": 124.76,
    "end_time": 126.739,
    "duration": 1.9789999999999992,
    "timecode": "00:02:04,760 --> 00:02:06,739",
    "is_recovered": false
  },
  {
    "scene_id": 54,
    "text": "2.5배나 빨라지는 거예요",
    "start_time": 126.739,
    "end_time": 128.099,
    "duration": 1.3599999999999852,
    "timecode": "00:02:06,739 --> 00:02:08,098",
    "is_recovered": false
  },
  {
    "scene_id": 55,
    "text": "진짜 대박은 따로 있어요",
    "start_time": 128.699,
    "end_time": 130.25900000000001,
    "duration": 1.5600000000000023,
    "timecode": "00:02:08,699 --> 00:02:10,259",
    "is_recovered": false
  },
  {
    "scene_id": 56,
    "text": "베이스다이라는 게 있는데요",
    "start_time": 130.86,
    "end_time": 131.919,
    "duration": 1.0589999999999975,
    "timecode": "00:02:10,860 --> 00:02:11,919",
    "is_recovered": false
  },
  {
    "scene_id": 57,
    "text": "이전까지는 그냥 칩들 연결해주는 통로였어요",
    "start_time": 132.419,
    "end_time": 134.919,
    "duration": 2.5,
    "timecode": "00:02:12,419 --> 00:02:14,919",
    "is_recovered": false
  },
  {
    "scene_id": 58,
    "text": "근데 HBM 4부터는 여기에 산 안호 공정 로직 칩이 들어가요",
    "start_time": 134.919,
    "end_time": 139.0,
    "duration": 4.080999999999989,
    "timecode": "00:02:14,919 --> 00:02:19,000",
    "is_recovered": false
  },
  {
    "scene_id": 59,
    "text": "메모리가 스스로 생각하기 시작한다라는 거예요",
    "start_time": 140.319,
    "end_time": 142.62,
    "duration": 2.301000000000016,
    "timecode": "00:02:20,318 --> 00:02:22,620",
    "is_recovered": false
  },
  {
    "scene_id": 60,
    "text": "단순히 데이터 저장하고 전달하는 게 아니라",
    "start_time": 143.219,
    "end_time": 145.199,
    "duration": 1.9800000000000182,
    "timecode": "00:02:23,218 --> 00:02:25,199",
    "is_recovered": false
  },
  {
    "scene_id": 61,
    "text": "간단한 연산도 직접 해버리는 거죠",
    "start_time": 145.699,
    "end_time": 147.46,
    "duration": 1.7609999999999957,
    "timecode": "00:02:25,699 --> 00:02:27,460",
    "is_recovered": false
  },
  {
    "scene_id": 62,
    "text": "결국 HBM 4는 그냥 빨라진 메모리가 아니에요",
    "start_time": 147.46,
    "end_time": 150.539,
    "duration": 3.0789999999999793,
    "timecode": "00:02:27,460 --> 00:02:30,538",
    "is_recovered": false
  },
  {
    "scene_id": 63,
    "text": "메모리의 개념 자체가 바뀌는 거예요",
    "start_time": 151.099,
    "end_time": 152.86,
    "duration": 1.761000000000024,
    "timecode": "00:02:31,098 --> 00:02:32,860",
    "is_recovered": false
  },
  {
    "scene_id": 64,
    "text": "자 그러면 이 시장에서 누가 이기고 있냐",
    "start_time": 153.07999999999998,
    "end_time": 155.3,
    "duration": 2.2200000000000273,
    "timecode": "00:02:33,079 --> 00:02:35,300",
    "is_recovered": false
  },
  {
    "scene_id": 65,
    "text": "여기서부터 진짜 재미있어져요",
    "start_time": 155.3,
    "end_time": 157.3,
    "duration": 2.0,
    "timecode": "00:02:35,300 --> 00:02:37,300",
    "is_recovered": false
  },
  {
    "scene_id": 66,
    "text": "2024년 기준으로 HBM 시장 점유율 아세요",
