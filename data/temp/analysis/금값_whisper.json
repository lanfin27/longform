[
  {
    "scene_id": 1,
    "text": "여러분 지금 금값이 날리죠?",
    "start_time": 0.0,
    "end_time": 1.56,
    "duration": 1.56,
    "timecode": "00:00:00,000 --> 00:00:01,560",
    "is_recovered": false
  },
  {
    "scene_id": 2,
    "text": "올해 1월의 국제금 가격이 온수당 5,608달러를 찍었어요",
    "start_time": 2.08,
    "end_time": 5.599,
    "duration": 3.519,
    "timecode": "00:00:02,080 --> 00:00:05,599",
    "is_recovered": false
  },
  {
    "scene_id": 3,
    "text": "역대 최고가에요?",
    "start_time": 5.599,
    "end_time": 6.96,
    "duration": 1.3609999999999998,
    "timecode": "00:00:05,599 --> 00:00:06,960",
    "is_recovered": false
  },
  {
    "scene_id": 4,
    "text": "근데 바로 다음날 하루 만에 16%가 폭락했거든요",
    "start_time": 7.36,
    "end_time": 10.58,
    "duration": 3.2199999999999998,
    "timecode": "00:00:07,360 --> 00:00:10,580",
    "is_recovered": false
  },
  {
    "scene_id": 5,
    "text": "시가총액으로 따지면요",
    "start_time": 11.119,
    "end_time": 12.599,
    "duration": 1.4800000000000004,
    "timecode": "00:00:11,118 --> 00:00:12,599",
    "is_recovered": false
  },
  {
    "scene_id": 6,
    "text": "무려 7.4조 달러가 증발한 거예요",
    "start_time": 12.599,
    "end_time": 14.56,
    "duration": 1.9610000000000003,
    "timecode": "00:00:12,599 --> 00:00:14,560",
    "is_recovered": false
  },
  {
    "scene_id": 7,
    "text": "우리 돈으로 일경 원이에요",
    "start_time": 14.98,
    "end_time": 16.48,
    "duration": 1.5,
    "timecode": "00:00:14,980 --> 00:00:16,480",
    "is_recovered": false
  },
  {
    "scene_id": 8,
    "text": "일경",
    "start_time": 17.0,
    "end_time": 17.44,
    "duration": 0.4400000000000013,
    "timecode": "00:00:17,000 --> 00:00:17,440",
    "is_recovered": false
  },
  {
    "scene_id": 9,
    "text": "대체 무슨 일이 있었던 걸까요?",
    "start_time": 17.44,
    "end_time": 19.26,
    "duration": 1.8200000000000003,
    "timecode": "00:00:17,440 --> 00:00:19,260",
    "is_recovered": false
  },
  {
    "scene_id": 10,
    "text": "자 시작해 볼게요",
    "start_time": 19.839,
    "end_time": 20.6,
    "duration": 0.7610000000000028,
    "timecode": "00:00:19,838 --> 00:00:20,600",
    "is_recovered": false
  },
  {
    "scene_id": 11,
    "text": "일단 기본부터 깔고 가야 해요",
    "start_time": 20.98,
    "end_time": 22.64,
    "duration": 1.6600000000000001,
    "timecode": "00:00:20,980 --> 00:00:22,640",
    "is_recovered": false
  },
  {
    "scene_id": 12,
    "text": "금이 왜 이렇게까지 올랐는지 아시는 분 계세요?",
    "start_time": 22.64,
    "end_time": 25.26,
    "duration": 2.620000000000001,
    "timecode": "00:00:22,640 --> 00:00:25,260",
    "is_recovered": false
  },
  {
    "scene_id": 13,
    "text": "2025년 한 해 동안 금 가격이 얼마나 올랐냐면요",
    "start_time": 25.719,
    "end_time": 28.719,
    "duration": 3.0,
    "timecode": "00:00:25,719 --> 00:00:28,719",
    "is_recovered": false
  },
  {
    "scene_id": 14,
    "text": "64%에요",
    "start_time": 28.719,
    "end_time": 30.12,
    "duration": 1.4009999999999998,
    "timecode": "00:00:28,719 --> 00:00:30,120",
    "is_recovered": false
  },
  {
    "scene_id": 15,
    "text": "주식도 아니고 금이 64% 올랐다고요",
    "start_time": 30.6,
    "end_time": 32.979,
    "duration": 2.378999999999998,
    "timecode": "00:00:30,600 --> 00:00:32,978",
    "is_recovered": false
  },
  {
    "scene_id": 16,
    "text": "이게 어느 정도냐면요",
    "start_time": 32.979,
    "end_time": 34.6,
    "duration": 1.6210000000000022,
    "timecode": "00:00:32,978 --> 00:00:34,600",
    "is_recovered": false
  },
  {
    "scene_id": 17,
    "text": "코스피가 1년에 20% 오르면 대박이라고 하잖아요",
    "start_time": 34.6,
    "end_time": 37.799,
    "duration": 3.198999999999998,
    "timecode": "00:00:34,600 --> 00:00:37,798",
    "is_recovered": false
  },
  {
    "scene_id": 18,
    "text": "금이 그 3배를 오른 거예요",
    "start_time": 38.34,
    "end_time": 39.619,
    "duration": 1.2789999999999964,
    "timecode": "00:00:38,340 --> 00:00:39,618",
    "is_recovered": false
  },
  {
    "scene_id": 19,
    "text": "그럼 왜 이렇게 된 거냐?",
    "start_time": 39.619,
    "end_time": 40.74,
    "duration": 1.1210000000000022,
    "timecode": "00:00:39,618 --> 00:00:40,740",
    "is_recovered": false
  },
  {
    "scene_id": 20,
    "text": "2025년 7월 4일로 가봐야 해요",
    "start_time": 41.119,
    "end_time": 43.219,
    "duration": 2.1000000000000014,
    "timecode": "00:00:41,118 --> 00:00:43,219",
    "is_recovered": false
  },
  {
    "scene_id": 21,
    "text": "미국 독립기념일에 트럼프 대통령이 뭘 했을 했냐면요",
    "start_time": 43.219,
    "end_time": 47.24,
    "duration": 4.021000000000001,
    "timecode": "00:00:43,219 --> 00:00:47,240",
    "is_recovered": false
  },
  {
    "scene_id": 22,
    "text": "원 빅 뷰티풀 빅이라는 법안에 서명했어요",
    "start_time": 47.24,
    "end_time": 49.679,
    "duration": 2.439,
    "timecode": "00:00:47,240 --> 00:00:49,679",
    "is_recovered": false
  },
  {
    "scene_id": 23,
    "text": "영어로 오비비비 A라고 하는데요",
    "start_time": 49.679,
    "end_time": 51.78,
    "duration": 2.100999999999999,
    "timecode": "00:00:49,679 --> 00:00:51,780",
    "is_recovered": false
  },
  {
    "scene_id": 24,
    "text": "이름은 예쁜데 내용은 좀 무서워요",
    "start_time": 52.28,
    "end_time": 54.659,
    "duration": 2.378999999999998,
    "timecode": "00:00:52,280 --> 00:00:54,658",
    "is_recovered": false
  },
  {
    "scene_id": 25,
    "text": "뭐가 들어있냐면요",
    "start_time": 54.659,
    "end_time": 56.1,
    "duration": 1.4410000000000025,
    "timecode": "00:00:54,658 --> 00:00:56,100",
    "is_recovered": false
  },
  {
    "scene_id": 26,
    "text": "대규모 감세, 국방비 증액",
    "start_time": 56.1,
    "end_time": 58.399,
    "duration": 2.2989999999999995,
    "timecode": "00:00:56,100 --> 00:00:58,399",
    "is_recovered": false
  },
  {
    "scene_id": 27,
    "text": "그리고 부채 한도 5조 달러 증액이에요",
    "start_time": 58.399,
    "end_time": 60.88,
    "duration": 2.4810000000000016,
    "timecode": "00:00:58,399 --> 00:01:00,880",
    "is_recovered": false
  },
  {
    "scene_id": 28,
    "text": "의회에 산처 분석에 따르면",
    "start_time": 61.46,
    "end_time": 62.799,
    "duration": 1.3389999999999986,
    "timecode": "00:01:01,460 --> 00:01:02,798",
    "is_recovered": false
  },
  {
    "scene_id": 29,
    "text": "이 법안 때문에 앞으로 10년간 미국 재정 적자가",
    "start_time": 63.07,
    "end_time": 66.739,
    "duration": 3.669000000000004,
    "timecode": "00:01:03,070 --> 00:01:06,739",
    "is_recovered": false
  },
  {
    "scene_id": 30,
    "text": "3조 달러 이상 늘어난대요",
    "start_time": 66.739,
    "end_time": 69.12,
    "duration": 2.3810000000000002,
    "timecode": "00:01:06,739 --> 00:01:09,120",
    "is_recovered": false
  },
  {
    "scene_id": 31,
    "text": "시장이 이걸 어떻게 받아들였겠어요?",
    "start_time": 69.12,
    "end_time": 70.76,
    "duration": 1.6400000000000006,
    "timecode": "00:01:09,120 --> 00:01:10,760",
    "is_recovered": false
  },
  {
    "scene_id": 32,
    "text": "달러 가치가 떨어질 거라고 본 거예요",
    "start_time": 71.219,
    "end_time": 72.9,
    "duration": 1.6810000000000116,
    "timecode": "00:01:11,218 --> 00:01:12,900",
    "is_recovered": false
  },
  {
    "scene_id": 33,
    "text": "달러 떨어지면 뭐가 오르죠?",
    "start_time": 73.349,
    "end_time": 74.879,
    "duration": 1.5300000000000011,
    "timecode": "00:01:13,349 --> 00:01:14,879",
    "is_recovered": false
  },
  {
    "scene_id": 34,
    "text": "금이요?",
    "start_time": 75.42,
    "end_time": 75.819,
    "duration": 0.3990000000000009,
    "timecode": "00:01:15,420 --> 00:01:15,819",
    "is_recovered": false
  },
  {
    "scene_id": 35,
    "text": "투자자들이 우르르 금으로 몰려들었어요",
    "start_time": 76.26,
    "end_time": 78.099,
    "duration": 1.8389999999999986,
    "timecode": "00:01:16,260 --> 00:01:18,099",
    "is_recovered": false
  },
  {
    "scene_id": 36,
    "text": "달러 말고 진짜 돈을 갖고 싶다",
    "start_time": 78.53,
    "end_time": 80.78,
    "duration": 2.25,
    "timecode": "00:01:18,530 --> 00:01:20,780",
    "is_recovered": false
  },
  {
    "scene_id": 37,
    "text": "이런 심리였던 거죠",
    "start_time": 80.78,
    "end_time": 82.07900000000001,
    "duration": 1.2990000000000066,
    "timecode": "00:01:20,780 --> 00:01:22,079",
    "is_recovered": false
  },
  {
    "scene_id": 38,
    "text": "근데 여기서 끝이 아니었어요",
    "start_time": 82.07900000000001,
    "end_time": 84.15899999999999,
    "duration": 2.079999999999984,
    "timecode": "00:01:22,079 --> 00:01:24,158",
    "is_recovered": false
  },
  {
    "scene_id": 39,
    "text": "2026년 1월에 무슨 일이 터졌냐면요",
    "start_time": 84.15899999999999,
    "end_time": 87.07900000000001,
    "duration": 2.920000000000016,
    "timecode": "00:01:24,158 --> 00:01:27,079",
    "is_recovered": false
  },
  {
    "scene_id": 40,
    "text": "트럼프가 캐나다랑 멕시코한테 100% 관세를 예고했어요",
    "start_time": 87.07900000000001,
    "end_time": 90.64,
    "duration": 3.560999999999993,
    "timecode": "00:01:27,079 --> 00:01:30,640",
    "is_recovered": false
  },
  {
    "scene_id": 41,
    "text": "한국산 수입품에도 새로운 무역 장벽을 시사했고요",
    "start_time": 91.239,
    "end_time": 93.85900000000001,
    "duration": 2.6200000000000045,
    "timecode": "00:01:31,239 --> 00:01:33,859",
    "is_recovered": false
  },
  {
    "scene_id": 42,
    "text": "중동에서는 미국 해군이 이란 쪽으로 대규모 이동했어요",
    "start_time": 94.439,
    "end_time": 97.4,
    "duration": 2.9610000000000127,
    "timecode": "00:01:34,438 --> 00:01:37,400",
    "is_recovered": false
  },
  {
    "scene_id": 43,
    "text": "그린란드 병합 얘기까지 나왔거든요",
    "start_time": 97.92,
    "end_time": 99.75999999999999,
    "duration": 1.8399999999999892,
    "timecode": "00:01:37,920 --> 00:01:39,759",
    "is_recovered": false
  },
  {
    "scene_id": 44,
    "text": "저 시장이 완전 패닉 상태가 된 거예요",
    "start_time": 99.75999999999999,
    "end_time": 101.85900000000001,
    "duration": 2.099000000000018,
    "timecode": "00:01:39,759 --> 00:01:41,859",
    "is_recovered": false
  },
  {
    "scene_id": 45,
    "text": "이런 상황에서 투자자들이 어디로 도망가겠어요?",
    "start_time": 102.2,
    "end_time": 104.59899999999999,
    "duration": 2.3989999999999867,
    "timecode": "00:01:42,200 --> 00:01:44,598",
    "is_recovered": false
  },
  {
    "scene_id": 46,
    "text": "그래서 1월 한 달 만에 금이 30% 더 올랐어요",
    "start_time": 105.819,
    "end_time": 109.739,
    "duration": 3.9200000000000017,
    "timecode": "00:01:45,819 --> 00:01:49,739",
    "is_recovered": false
  },
  {
    "scene_id": 47,
    "text": "여기서 중요한 게 하나 더 있어요",
    "start_time": 109.739,
    "end_time": 111.5,
    "duration": 1.7609999999999957,
    "timecode": "00:01:49,739 --> 00:01:51,500",
    "is_recovered": false
  },
  {
    "scene_id": 48,
    "text": "중앙은행들이에요",
    "start_time": 112.03999999999999,
    "end_time": 112.9,
    "duration": 0.8600000000000136,
    "timecode": "00:01:52,039 --> 00:01:52,900",
    "is_recovered": false
  },
  {
    "scene_id": 49,
    "text": "전 세계 중앙은행들이 금을 미친 듯이 사들였거든요",
    "start_time": 112.9,
    "end_time": 116.439,
    "duration": 3.5389999999999873,
    "timecode": "00:01:52,900 --> 00:01:56,438",
    "is_recovered": false
  },
  {
    "scene_id": 50,
    "text": "지난 3년 동안 매년 1000톤 이상 샀어요",
    "start_time": 116.709,
    "end_time": 119.299,
    "duration": 2.5900000000000034,
    "timecode": "00:01:56,709 --> 00:01:59,299",
    "is_recovered": false
  },
  {
    "scene_id": 51,
    "text": "그 전 10년 평균이 500톤이었거든요",
    "start_time": 119.299,
    "end_time": 121.62,
    "duration": 2.320999999999998,
    "timecode": "00:01:59,299 --> 00:02:01,620",
    "is_recovered": false
  },
  {
    "scene_id": 52,
    "text": "두 배로 늘어난 거예요",
    "start_time": 121.849,
    "end_time": 123.019,
    "duration": 1.1700000000000017,
    "timecode": "00:02:01,849 --> 00:02:03,019",
    "is_recovered": false
  },
  {
    "scene_id": 53,
    "text": "왜 이러냐고요? 탈달러화예요",
    "start_time": 123.31,
    "end_time": 125.439,
    "duration": 2.1289999999999907,
    "timecode": "00:02:03,310 --> 00:02:05,438",
    "is_recovered": false
  },
  {
    "scene_id": 54,
    "text": "미국이 러시아 제재하면서 달러자산 동결했잖아요",
    "start_time": 125.969,
    "end_time": 128.56,
    "duration": 2.591000000000008,
    "timecode": "00:02:05,968 --> 00:02:08,560",
    "is_recovered": false
  },
  {
    "scene_id": 55,
    "text": "그거 보고 다른 나라들이 생각한 거예요",
    "start_time": 128.909,
    "end_time": 131.3,
    "duration": 2.3910000000000196,
    "timecode": "00:02:08,908 --> 00:02:11,300",
    "is_recovered": false
  },
  {
    "scene_id": 56,
    "text": "우리도 언제 저렇게 될지 모르겠네",
    "start_time": 131.909,
    "end_time": 133.599,
    "duration": 1.6899999999999977,
    "timecode": "00:02:11,908 --> 00:02:13,598",
    "is_recovered": false
  },
  {
    "scene_id": 57,
    "text": "금으로 바꿔놓자",
    "start_time": 133.599,
    "end_time": 134.86,
    "duration": 1.261000000000024,
    "timecode": "00:02:13,598 --> 00:02:14,860",
    "is_recovered": false
  },
  {
    "scene_id": 58,
    "text": "중국, 폴란드, 인도가 특히 많이 샀어요",
    "start_time": 135.25,
    "end_time": 138.06,
    "duration": 2.8100000000000023,
    "timecode": "00:02:15,250 --> 00:02:18,060",
    "is_recovered": false
  },
  {
    "scene_id": 59,
    "text": "폴란드는 2025년에만 95톤을 추가로 사서",
    "start_time": 138.55,
    "end_time": 141.74,
    "duration": 3.1899999999999977,
    "timecode": "00:02:18,550 --> 00:02:21,740",
    "is_recovered": false
  },
  {
    "scene_id": 60,
    "text": "세계 1위 순매수국이 됐거든요",
    "start_time": 141.74,
    "end_time": 144.18,
    "duration": 2.4399999999999977,
    "timecode": "00:02:21,740 --> 00:02:24,180",
    "is_recovered": false
  },
  {
    "scene_id": 61,
    "text": "근데 여기서 좀 습스란 얘기가 있어요",
    "start_time": 144.18,
    "end_time": 146.96,
    "duration": 2.780000000000001,
    "timecode": "00:02:24,180 --> 00:02:26,960",
    "is_recovered": false
  },
  {
    "scene_id": 62,
    "text": "한국은행이에요",
    "start_time": 146.96,
    "end_time": 147.9,
    "duration": 0.9399999999999977,
    "timecode": "00:02:26,960 --> 00:02:27,900",
    "is_recovered": false
  },
  {
    "scene_id": 63,
    "text": "한국은행 금 보유량이 얼마인지 아세요?",
    "start_time": 147.9,
    "end_time": 150.139,
    "duration": 2.2390000000000043,
    "timecode": "00:02:27,900 --> 00:02:30,139",
    "is_recovered": false
  },
  {
    "scene_id": 64,
    "text": "104.4톤이에요",
    "start_time": 150.46,
    "end_time": 151.47899999999998,
    "duration": 1.018999999999977,
    "timecode": "00:02:30,460 --> 00:02:31,478",
    "is_recovered": false
  },
  {
    "scene_id": 65,
    "text": "근데 이게 언제부터 그대로냐면요",
    "start_time": 151.47899999999998,
    "end_time": 153.74,
    "duration": 2.261000000000024,
    "timecode": "00:02:31,478 --> 00:02:33,740",
    "is_recovered": false
  },
  {
    "scene_id": 66,
    "text": "2013년부터예요",
    "start_time": 153.74,
    "end_time": 155.02,
    "duration": 1.2800000000000011,
    "timecode": "00:02:33,740 --> 00:02:35,020",
    "is_recovered": false
  },
  {
    "scene_id": 67,
    "text": "2013년째 그대로예요",
    "start_time": 155.02,
    "end_time": 156.139,
    "duration": 1.1189999999999998,
    "timecode": "00:02:35,020 --> 00:02:36,139",
    "is_recovered": false
  },
  {
    "scene_id": 68,
    "text": "그 사이에 세계 순위가 어떻게 되냐면요",
    "start_time": 156.139,
    "end_time": 158.5,
    "duration": 2.36099999999999,
    "timecode": "00:02:36,139 --> 00:02:38,500",
    "is_recovered": false
  },
  {
    "scene_id": 69,
    "text": "32위에서 39위로 추락했어요",
    "start_time": 158.5,
    "end_time": 160.699,
    "duration": 2.1990000000000123,
    "timecode": "00:02:38,500 --> 00:02:40,699",
    "is_recovered": false
  },
  {
    "scene_id": 70,
    "text": "한국은행은 금이 변동성이 크고",
    "start_time": 160.699,
    "end_time": 163.139,
    "duration": 2.4399999999999977,
    "timecode": "00:02:40,699 --> 00:02:43,139",
    "is_recovered": false
  },
  {
    "scene_id": 71,
    "text": "유동성이 낮다고 안 샀거든요",
    "start_time": 163.139,
    "end_time": 164.68,
    "duration": 1.5409999999999968,
    "timecode": "00:02:43,139 --> 00:02:44,680",
    "is_recovered": false
  },
  {
    "scene_id": 72,
    "text": "근데 결과적으로 어떻게 됐어요?",
    "start_time": 164.68,
    "end_time": 166.699,
    "duration": 2.0190000000000055,
    "timecode": "00:02:44,680 --> 00:02:46,699",
    "is_recovered": false
  },
  {
    "scene_id": 73,
    "text": "금값이 폭등하는 동안 우리만 구경한 거예요",
    "start_time": 167.139,
    "end_time": 169.31900000000002,
    "duration": 2.180000000000007,
    "timecode": "00:02:47,139 --> 00:02:49,319",
    "is_recovered": false
  },
  {
    "scene_id": 74,
    "text": "그러면 월가에서는 앞으로 금이 얼마까지 갈 거라고 봤을까요?",
    "start_time": 169.78,
    "end_time": 173.0,
    "duration": 3.219999999999999,
    "timecode": "00:02:49,780 --> 00:02:53,000",
    "is_recovered": false
  },
  {
    "scene_id": 75,
    "text": "JP 모건이 뭐라고 했으냐면요",
    "start_time": 173.41899999999998,
    "end_time": 175.3,
    "duration": 1.8810000000000286,
    "timecode": "00:02:53,418 --> 00:02:55,300",
    "is_recovered": false
  },
  {
    "scene_id": 76,
    "text": "온수당 8500달러까지 갈 수 있대요",
    "start_time": 175.3,
    "end_time": 177.36,
    "duration": 2.0600000000000023,
    "timecode": "00:02:55,300 --> 00:02:57,360",
    "is_recovered": false
  },
  {
    "scene_id": 77,
    "text": "지금 가격에 1.5배예요",
    "start_time": 177.36,
    "end_time": 179.219,
    "duration": 1.8589999999999804,
    "timecode": "00:02:57,360 --> 00:02:59,218",
    "is_recovered": false
  },
  {
    "scene_id": 78,
    "text": "왜 이런 예측을 했으냐면요",
    "start_time": 179.219,
    "end_time": 181.52,
    "duration": 2.301000000000016,
    "timecode": "00:02:59,218 --> 00:03:01,520",
    "is_recovered": false
  },
  {
    "scene_id": 79,
    "text": "개인 투자자들 포트폴리오에서 금 비중이 계속 늘고 있거든요",
    "start_time": 181.52,
    "end_time": 185.18,
    "duration": 3.6599999999999966,
    "timecode": "00:03:01,520 --> 00:03:05,180",
    "is_recovered": false
  },
  {
    "scene_id": 80,
    "text": "10년 전에는 1%였는데",
    "start_time": 185.75900000000001,
    "end_time": 187.5,
    "duration": 1.7409999999999854,
    "timecode": "00:03:05,759 --> 00:03:07,500",
    "is_recovered": false
  },
  {
    "scene_id": 81,
    "text": "지금은 3%예요",
    "start_time": 187.5,
    "end_time": 189.219,
    "duration": 1.718999999999994,
    "timecode": "00:03:07,500 --> 00:03:09,218",
    "is_recovered": false
  },
  {
    "scene_id": 82,
    "text": "이게 4.6%까지 가면요",
    "start_time": 189.219,
    "end_time": 191.4,
    "duration": 2.1810000000000116,
    "timecode": "00:03:09,218 --> 00:03:11,400",
    "is_recovered": false
  },
  {
    "scene_id": 83,
    "text": "수요 폭발로 8000달러 넘는다는 계산이에요",
    "start_time": 191.4,
    "end_time": 194.12,
    "duration": 2.719999999999999,
    "timecode": "00:03:11,400 --> 00:03:14,120",
    "is_recovered": false
  },
  {
    "scene_id": 84,
    "text": "야데니 리서치는 아예 2030년까지 만 달러 간다고 했어요",
    "start_time": 194.74,
    "end_time": 198.099,
    "duration": 3.3589999999999804,
    "timecode": "00:03:14,740 --> 00:03:18,098",
    "is_recovered": false
  },
  {
    "scene_id": 85,
    "text": "근데요",
    "start_time": 198.599,
    "end_time": 199.07999999999998,
    "duration": 0.48099999999999454,
    "timecode": "00:03:18,598 --> 00:03:19,079",
    "is_recovered": false
  },
  {
    "scene_id": 86,
    "text": "여기서 반전이 옵니다",
    "start_time": 199.07999999999998,
    "end_time": 200.539,
    "duration": 1.4590000000000032,
    "timecode": "00:03:19,079 --> 00:03:20,538",
    "is_recovered": false
  },
  {
    "scene_id": 87,
    "text": "진짜 이야기는 지금부터예요",
    "start_time": 200.539,
    "end_time": 202.18,
    "duration": 1.6410000000000196,
    "timecode": "00:03:20,538 --> 00:03:22,180",
    "is_recovered": false
  },
  {
    "scene_id": 88,
    "text": "2026년 1월 31일이에요",
    "start_time": 202.18,
    "end_time": 204.02,
    "duration": 1.8400000000000034,
    "timecode": "00:03:22,180 --> 00:03:24,020",
    "is_recovered": false
  },
  {
    "scene_id": 89,
    "text": "금요일이었거든요",
    "start_time": 204.02,
    "end_time": 204.9,
    "duration": 0.8799999999999955,
    "timecode": "00:03:24,020 --> 00:03:24,900",
    "is_recovered": false
  },
  {
    "scene_id": 90,
    "text": "전날 금 가격이 사상 최고치 5600달러를 찍었어요",
    "start_time": 204.9,
    "end_time": 208.97899999999998,
    "duration": 4.078999999999979,
    "timecode": "00:03:24,900 --> 00:03:28,978",
    "is_recovered": false
  },
  {
    "scene_id": 91,
    "text": "모두가 축제 분위기였죠",
    "start_time": 208.97899999999998,
    "end_time": 210.8,
    "duration": 1.8210000000000264,
    "timecode": "00:03:28,978 --> 00:03:30,800",
    "is_recovered": false
  },
  {
    "scene_id": 92,
    "text": "근데 그날 오후에 뉴스가 하나 떴어요",
    "start_time": 210.8,
    "end_time": 213.75900000000001,
    "duration": 2.959000000000003,
    "timecode": "00:03:30,800 --> 00:03:33,759",
    "is_recovered": false
  },
  {
    "scene_id": 93,
    "text": "트럼프가 차기 연준 의장 후보를 발표한 거예요",
    "start_time": 213.75900000000001,
    "end_time": 216.719,
    "duration": 2.9599999999999795,
    "timecode": "00:03:33,759 --> 00:03:36,718",
    "is_recovered": false
  },
  {
    "scene_id": 94,
    "text": "누구냐면요",
    "start_time": 216.719,
    "end_time": 217.8,
    "duration": 1.0810000000000173,
    "timecode": "00:03:36,718 --> 00:03:37,800",
    "is_recovered": false
  },
  {
    "scene_id": 95,
    "text": "케빈 워시예요",
    "start_time": 217.8,
    "end_time": 218.939,
    "duration": 1.1389999999999816,
    "timecode": "00:03:37,800 --> 00:03:38,938",
    "is_recovered": false
  },
  {
    "scene_id": 96,
    "text": "케빈 워시가 누구냐고요?",
    "start_time": 218.939,
    "end_time": 220.56,
    "duration": 1.6210000000000093,
    "timecode": "00:03:38,938 --> 00:03:40,560",
    "is_recovered": false
  },
  {
    "scene_id": 97,
    "text": "전 연준 이사 출신이고요",
    "start_time": 220.75900000000001,
    "end_time": 222.12,
    "duration": 1.36099999999999,
    "timecode": "00:03:40,759 --> 00:03:42,120",
    "is_recovered": false
  },
  {
    "scene_id": 98,
    "text": "모건 스탠리 경영진이었어요",
    "start_time": 222.12,
    "end_time": 223.97899999999998,
    "duration": 1.8589999999999804,
    "timecode": "00:03:42,120 --> 00:03:43,978",
    "is_recovered": false
  },
  {
    "scene_id": 99,
    "text": "근데 이 사람 별명이 뭔지 아세요?",
    "start_time": 223.97899999999998,
    "end_time": 225.379,
    "duration": 1.4000000000000057,
    "timecode": "00:03:43,978 --> 00:03:45,378",
    "is_recovered": false
  },
  {
    "scene_id": 100,
    "text": "인플레이션 파숙군이에요",
    "start_time": 225.81900000000002,
    "end_time": 226.97899999999998,
    "duration": 1.1599999999999682,
    "timecode": "00:03:45,819 --> 00:03:46,978",
    "is_recovered": false
  },
  {
    "scene_id": 101,
    "text": "메파 중에 메파거든요",
    "start_time": 226.97899999999998,
    "end_time": 228.5,
    "duration": 1.521000000000015,
    "timecode": "00:03:46,978 --> 00:03:48,500",
    "is_recovered": false
  },
  {
    "scene_id": 102,
    "text": "금리 올리는 거 좋아하고",
    "start_time": 228.86,
    "end_time": 230.28,
    "duration": 1.4199999999999875,
    "timecode": "00:03:48,860 --> 00:03:50,280",
    "is_recovered": false
  },
  {
    "scene_id": 103,
    "text": "돈 푸는 거 싫어하는 사람이에요",
    "start_time": 230.28,
    "end_time": 232.02,
    "duration": 1.740000000000009,
    "timecode": "00:03:50,280 --> 00:03:52,020",
    "is_recovered": false
  },
  {
    "scene_id": 104,
    "text": "시장이 이걸 어떻게 해석했겠어요?",
    "start_time": 232.4,
    "end_time": 234.039,
    "duration": 1.6389999999999816,
    "timecode": "00:03:52,400 --> 00:03:54,038",
    "is_recovered": false
  },
  {
    "scene_id": 105,
    "text": "연준이 돈을 안 풀겠구나",
    "start_time": 234.68,
    "end_time": 235.879,
    "duration": 1.1989999999999839,
    "timecode": "00:03:54,680 --> 00:03:55,878",
    "is_recovered": false
  },
  {
    "scene_id": 106,
    "text": "달러가 강해지겠구나",
    "start_time": 236.36,
    "end_time": 237.74,
    "duration": 1.3799999999999955,
    "timecode": "00:03:56,360 --> 00:03:57,740",
    "is_recovered": false
  },
  {
    "scene_id": 107,
    "text": "그럼 금들고 있을 이유가 없잖아요",
    "start_time": 237.74,
    "end_time": 239.57999999999998,
    "duration": 1.839999999999975,
    "timecode": "00:03:57,740 --> 00:03:59,579",
    "is_recovered": false
  },
  {
    "scene_id": 108,
    "text": "순식간에 매도 물량이 쏟아졌어요",
    "start_time": 240.139,
    "end_time": 242.02,
    "duration": 1.8810000000000002,
    "timecode": "00:04:00,139 --> 00:04:02,020",
    "is_recovered": false
  },
  {
    "scene_id": 109,
    "text": "그 결과가 어떻게 됐어 했냐면요",
    "start_time": 242.02,
    "end_time": 244.439,
    "duration": 2.4189999999999827,
    "timecode": "00:04:02,020 --> 00:04:04,438",
    "is_recovered": false
  },
  {
    "scene_id": 110,
    "text": "지금 금이 하루 만에 13% 폭락했어요",
    "start_time": 244.439,
    "end_time": 246.5,
    "duration": 2.061000000000007,
    "timecode": "00:04:04,438 --> 00:04:06,500",
    "is_recovered": false
  },
  {
    "scene_id": 111,
    "text": "장중에는 16%까지 빠졌고요",
    "start_time": 246.5,
    "end_time": 248.919,
    "duration": 2.419000000000011,
    "timecode": "00:04:06,500 --> 00:04:08,919",
    "is_recovered": false
  },
  {
    "scene_id": 112,
    "text": "은은요",
    "start_time": 248.919,
    "end_time": 249.97899999999998,
    "duration": 1.0599999999999739,
    "timecode": "00:04:08,919 --> 00:04:09,978",
    "is_recovered": false
  },
  {
    "scene_id": 113,
    "text": "30%에서 최대 39%까지 떨어졌어요",
    "start_time": 249.97899999999998,
    "end_time": 253.099,
    "duration": 3.1200000000000045,
    "timecode": "00:04:09,978 --> 00:04:13,098",
    "is_recovered": false
  },
  {
    "scene_id": 114,
    "text": "2006년 이후 은 시장 최악의 날이었어요",
    "start_time": 253.099,
    "end_time": 256.139,
    "duration": 3.0400000000000205,
    "timecode": "00:04:13,098 --> 00:04:16,139",
    "is_recovered": false
  },
  {
    "scene_id": 115,
    "text": "근데 이게 사람이 판 게 아니에요",
    "start_time": 256.139,
    "end_time": 257.439,
    "duration": 1.3000000000000114,
    "timecode": "00:04:16,139 --> 00:04:17,439",
    "is_recovered": false
  },
  {
    "scene_id": 116,
    "text": "알고리즘이에요",
    "start_time": 257.98,
    "end_time": 258.819,
    "duration": 0.8389999999999986,
    "timecode": "00:04:17,980 --> 00:04:18,819",
    "is_recovered": false
  },
  {
    "scene_id": 117,
    "text": "가격이 떨어지기 시작하니까요",
    "start_time": 258.819,
    "end_time": 260.819,
    "duration": 2.0,
    "timecode": "00:04:18,819 --> 00:04:20,819",
    "is_recovered": false
  },
  {
    "scene_id": 118,
    "text": "미리 설정해둔 손절매 주문들이",
    "start_time": 260.819,
    "end_time": 262.959,
    "duration": 2.1399999999999864,
    "timecode": "00:04:20,819 --> 00:04:22,959",
    "is_recovered": false
  },
  {
    "scene_id": 119,
    "text": "도미노처럼 터진 거예요",
    "start_time": 262.959,
    "end_time": 264.1,
    "duration": 1.1410000000000196,
    "timecode": "00:04:22,959 --> 00:04:24,100",
    "is_recovered": false
  },
  {
    "scene_id": 120,
    "text": "레버리지 이 TF에서 강제 청산 물량이 쏟아졌고요",
    "start_time": 264.699,
    "end_time": 267.86,
    "duration": 3.1610000000000014,
    "timecode": "00:04:24,699 --> 00:04:27,860",
    "is_recovered": false
  },
  {
    "scene_id": 121,
    "text": "은 이 TF에서만 35억 달러가 한꺼번에 나왔어요",
    "start_time": 268.23,
    "end_time": 271.319,
    "duration": 3.0889999999999986,
    "timecode": "00:04:28,230 --> 00:04:31,319",
    "is_recovered": false
  },
  {
    "scene_id": 122,
    "text": "사람들이 팔고 싶어서 판 게 아니라요",
    "start_time": 271.319,
    "end_time": 273.519,
    "duration": 2.1999999999999886,
    "timecode": "00:04:31,319 --> 00:04:33,519",
    "is_recovered": false
  },
  {
    "scene_id": 123,
    "text": "기계가 자동으로 대답한 거예요",
    "start_time": 273.519,
    "end_time": 275.199,
    "duration": 1.6800000000000068,
    "timecode": "00:04:33,519 --> 00:04:35,199",
    "is_recovered": false
  },
  {
    "scene_id": 124,
    "text": "이날 금과 은 시장에서 증발한 시가 총액이요",
    "start_time": 275.67,
    "end_time": 278.399,
    "duration": 2.728999999999985,
    "timecode": "00:04:35,670 --> 00:04:38,399",
    "is_recovered": false
  },
  {
    "scene_id": 125,
    "text": "7.4조 달러에요",
    "start_time": 278.399,
    "end_time": 279.72,
    "duration": 1.3210000000000264,
    "timecode": "00:04:38,399 --> 00:04:39,720",
    "is_recovered": false
  },
  {
    "scene_id": 126,
    "text": "삼성전자 시가 총액이 400조 원 정도 되잖아요",
    "start_time": 282.06,
    "end_time": 284.74,
    "duration": 2.680000000000007,
    "timecode": "00:04:42,060 --> 00:04:44,740",
    "is_recovered": false
  },
  {
    "scene_id": 127,
    "text": "그게 25개가 하루 만에 사라진 거예요",
    "start_time": 284.74,
    "end_time": 287.459,
    "duration": 2.718999999999994,
    "timecode": "00:04:44,740 --> 00:04:47,459",
    "is_recovered": false
  },
  {
    "scene_id": 128,
    "text": "자 여기서 역사 얘기를 좀 해볼게요",
    "start_time": 287.72,
    "end_time": 289.939,
    "duration": 2.218999999999994,
    "timecode": "00:04:47,720 --> 00:04:49,939",
    "is_recovered": false
  },
  {
    "scene_id": 129,
    "text": "1970년대에도 비슷한 일이 있었거든요",
    "start_time": 291.079,
    "end_time": 293.06,
    "duration": 1.9809999999999945,
    "timecode": "00:04:51,079 --> 00:04:53,060",
    "is_recovered": false
  },
  {
    "scene_id": 130,
    "text": "1971년에 닉슨이 금태환을 정지했잖아요",
    "start_time": 293.98,
    "end_time": 297.139,
    "duration": 3.158999999999992,
    "timecode": "00:04:53,980 --> 00:04:57,139",
    "is_recovered": false
  },
  {
    "scene_id": 131,
    "text": "그 이후에 금이 폭등했다가",
    "start_time": 297.139,
    "end_time": 298.639,
    "duration": 1.5,
    "timecode": "00:04:57,139 --> 00:04:58,639",
    "is_recovered": false
  },
  {
    "scene_id": 132,
    "text": "1974년에 한 번 크게 조정받았어요",
    "start_time": 298.639,
    "end_time": 301.48,
    "duration": 2.841000000000008,
    "timecode": "00:04:58,639 --> 00:05:01,480",
    "is_recovered": false
  },
  {
    "scene_id": 133,
    "text": "11에서 12% 정도 빠졌고",
    "start_time": 301.48,
    "end_time": 303.819,
    "duration": 2.3389999999999986,
    "timecode": "00:05:01,480 --> 00:05:03,819",
    "is_recovered": false
  },
  {
    "scene_id": 134,
    "text": "4개월 반 정도 횡보했어요",
    "start_time": 303.819,
    "end_time": 305.779,
    "duration": 1.9599999999999795,
    "timecode": "00:05:03,819 --> 00:05:05,778",
    "is_recovered": false
  },
  {
    "scene_id": 135,
    "text": "근데 그 다음에 어떻게 됐냐면요",
    "start_time": 305.779,
    "end_time": 308.139,
    "duration": 2.3600000000000136,
    "timecode": "00:05:05,778 --> 00:05:08,139",
    "is_recovered": false
  },
  {
    "scene_id": 136,
    "text": "2차 렐리가 왔어요",
    "start_time": 308.139,
    "end_time": 309.5,
    "duration": 1.36099999999999,
    "timecode": "00:05:08,139 --> 00:05:09,500",
    "is_recovered": false
  },
  {
    "scene_id": 137,
    "text": "주식은 50% 폭락하는 동안 금만 올랐거든요",
    "start_time": 309.5,
    "end_time": 312.899,
    "duration": 3.399000000000001,
    "timecode": "00:05:09,500 --> 00:05:12,899",
    "is_recovered": false
  },
  {
    "scene_id": 138,
    "text": "지금이랑 비슷하지 않아요",
    "start_time": 313.439,
    "end_time": 314.48,
    "duration": 1.0409999999999968,
    "timecode": "00:05:13,439 --> 00:05:14,480",
    "is_recovered": false
  },
  {
    "scene_id": 139,
    "text": "재정적자 폭발, 지정학적 위기, 달러 실례 하락",
    "start_time": 315.1,
    "end_time": 318.819,
    "duration": 3.718999999999994,
    "timecode": "00:05:15,100 --> 00:05:18,819",
    "is_recovered": false
  },
  {
    "scene_id": 140,
    "text": "전문가들은 이번 폭락도",
    "start_time": 318.819,
    "end_time": 320.68,
    "duration": 1.86099999999999,
    "timecode": "00:05:18,819 --> 00:05:20,680",
    "is_recovered": false
  },
  {
    "scene_id": 141,
    "text": "장기 강세장 속에 건강한 조정일 수 있다고 봐요",
    "start_time": 320.68,
    "end_time": 323.56,
    "duration": 2.8799999999999955,
    "timecode": "00:05:20,680 --> 00:05:23,560",
    "is_recovered": false
  },
  {
    "scene_id": 142,
    "text": "그러면 앞으로 어떻게 될까요",
    "start_time": 323.56,
    "end_time": 325.259,
    "duration": 1.6990000000000123,
    "timecode": "00:05:23,560 --> 00:05:25,259",
    "is_recovered": false
  },
  {
    "scene_id": 143,
    "text": "3가지 변수가 있어요",
    "start_time": 325.74,
    "end_time": 327.06,
    "duration": 1.3199999999999932,
    "timecode": "00:05:25,740 --> 00:05:27,060",
    "is_recovered": false
  },
  {
    "scene_id": 144,
    "text": "첫째, 캐빈 워시가 실제로 연준 의장이 되느냐",
    "start_time": 327.06,
    "end_time": 330.519,
    "duration": 3.459000000000003,
    "timecode": "00:05:27,060 --> 00:05:30,519",
    "is_recovered": false
  },
  {
    "scene_id": 145,
    "text": "워시가 취임하면 금니이나가 늦춰질 거예요",
    "start_time": 330.519,
    "end_time": 333.56,
    "duration": 3.040999999999997,
    "timecode": "00:05:30,519 --> 00:05:33,560",
    "is_recovered": false
  },
  {
    "scene_id": 146,
    "text": "단기적으로 금한테는 안 좋죠",
    "start_time": 334.18,
    "end_time": 335.98,
    "duration": 1.8000000000000114,
    "timecode": "00:05:34,180 --> 00:05:35,980",
    "is_recovered": false
  },
  {
    "scene_id": 147,
    "text": "둘째, 미국 부채 문제에요",
    "start_time": 335.98,
    "end_time": 338.019,
    "duration": 2.0389999999999873,
    "timecode": "00:05:35,980 --> 00:05:38,019",
    "is_recovered": false
  },
  {
    "scene_id": 148,
    "text": "지금 미국 부채가 36조 달러거든요",
    "start_time": 338.019,
    "end_time": 340.779,
    "duration": 2.759999999999991,
    "timecode": "00:05:38,019 --> 00:05:40,778",
    "is_recovered": false
  },
  {
    "scene_id": 149,
    "text": "연간 이자 비용만 1조 달러가 넘어요",
    "start_time": 341.279,
    "end_time": 343.439,
    "duration": 2.160000000000025,
    "timecode": "00:05:41,278 --> 00:05:43,439",
    "is_recovered": false
  },
  {
    "scene_id": 150,
    "text": "결국 연준이 금니를 낮출 수밖에 없다는 시각도 있어요",
    "start_time": 343.759,
    "end_time": 347.22,
    "duration": 3.4610000000000127,
    "timecode": "00:05:43,759 --> 00:05:47,220",
    "is_recovered": false
  },
  {
    "scene_id": 151,
    "text": "그러면 금이 다시 오르겠죠",
    "start_time": 347.22,
    "end_time": 348.72,
    "duration": 1.5,
    "timecode": "00:05:47,220 --> 00:05:48,720",
    "is_recovered": false
  },
  {
    "scene_id": 152,
    "text": "셋째, 지정학적 리스크에요",
    "start_time": 349.259,
    "end_time": 351.15999999999997,
    "duration": 1.9009999999999536,
    "timecode": "00:05:49,259 --> 00:05:51,159",
    "is_recovered": false
  },
  {
    "scene_id": 153,
    "text": "미중 갈등, 중동 긴장, 무역 전쟁",
    "start_time": 351.15999999999997,
    "end_time": 354.65999999999997,
    "duration": 3.5,
    "timecode": "00:05:51,159 --> 00:05:54,659",
    "is_recovered": false
  },
  {
    "scene_id": 154,
    "text": "이게 계속되면 금 수요는 줄지 않아요",
    "start_time": 354.65999999999997,
    "end_time": 357.519,
    "duration": 2.8590000000000373,
    "timecode": "00:05:54,659 --> 00:05:57,519",
    "is_recovered": false
  },
  {
    "scene_id": 155,
    "text": "오늘 얘기 정리해 볼게요",
    "start_time": 357.86,
    "end_time": 359.199,
    "duration": 1.3389999999999986,
    "timecode": "00:05:57,860 --> 00:05:59,199",
    "is_recovered": false
  },
  {
    "scene_id": 156,
    "text": "2025년에서 2026년 초까지",
    "start_time": 359.86,
    "end_time": 362.42,
    "duration": 2.5600000000000023,
    "timecode": "00:05:59,860 --> 00:06:02,420",
    "is_recovered": false
  },
  {
    "scene_id": 157,
    "text": "금 시장은 역대급 렐리와 역대급 폭락을 동시에 경험했어요",
    "start_time": 362.42,
    "end_time": 366.819,
    "duration": 4.399000000000001,
    "timecode": "00:06:02,420 --> 00:06:06,819",
    "is_recovered": false
  },
  {
    "scene_id": 158,
    "text": "미국의 재정평창과 지정학적 위기가",
    "start_time": 367.42,
    "end_time": 369.62,
    "duration": 2.1999999999999886,
    "timecode": "00:06:07,420 --> 00:06:09,620",
    "is_recovered": false
  },
  {
    "scene_id": 159,
    "text": "금을 5600달러까지 밀어올렸고요",
    "start_time": 369.62,
    "end_time": 371.72,
    "duration": 2.1000000000000227,
    "timecode": "00:06:09,620 --> 00:06:11,720",
    "is_recovered": false
  },
  {
    "scene_id": 160,
    "text": "캐빈 워시라는 한 사람의 등장이 하루 만에 일경원을 증발시켰어요",
    "start_time": 371.72,
    "end_time": 375.92,
    "duration": 4.199999999999989,
    "timecode": "00:06:11,720 --> 00:06:15,920",
    "is_recovered": false
  },
  {
    "scene_id": 161,
    "text": "결국 이 이야기는요",
    "start_time": 375.92,
    "end_time": 377.6,
    "duration": 1.6800000000000068,
    "timecode": "00:06:15,920 --> 00:06:17,600",
    "is_recovered": false
  },
  {
    "scene_id": 162,
    "text": "돈의 본질이 먼지에 대한 이야기이기도 해요",
    "start_time": 377.6,
    "end_time": 380.3,
    "duration": 2.6999999999999886,
    "timecode": "00:06:17,600 --> 00:06:20,300",
    "is_recovered": false
  },
  {
    "scene_id": 163,
    "text": "종이 위에 찍힌 숫자를 믿을 거냐",
    "start_time": 380.79,
    "end_time": 382.8,
    "duration": 2.009999999999991,
    "timecode": "00:06:20,790 --> 00:06:22,800",
    "is_recovered": false
  },
  {
    "scene_id": 164,
    "text": "아니면 수천년간 가치를 인정받은 노란 금속을 믿을 거냐",
    "start_time": 382.8,
    "end_time": 387.16,
    "duration": 4.360000000000014,
    "timecode": "00:06:22,800 --> 00:06:27,160",
    "is_recovered": false
  },
  {
    "scene_id": 165,
    "text": "시장은 지금 그 질문 앞에 서 있어요",
    "start_time": 387.16,
    "end_time": 389.339,
    "duration": 2.1789999999999736,
    "timecode": "00:06:27,160 --> 00:06:29,338",
    "is_recovered": false
  },
  {
    "scene_id": 166,
    "text": "여러분은 어떻게 생각하세요",
    "start_time": 389.339,
    "end_time": 390.939,
    "duration": 1.6000000000000227,
    "timecode": "00:06:29,338 --> 00:06:30,939",
    "is_recovered": false
  },
  {
    "scene_id": 167,
    "text": "금이 다시 8000달러를 향해 달릴 수 있을까요",
    "start_time": 391.41,
    "end_time": 393.639,
    "duration": 2.228999999999985,
    "timecode": "00:06:31,410 --> 00:06:33,639",
    "is_recovered": false
  }
