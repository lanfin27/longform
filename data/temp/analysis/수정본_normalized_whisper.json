[
  {
    "scene_id": 1,
    "text": "지금 한화가 유럽에서 뭘 하고 있는지 아세요?",
    "start_time": 0.13,
    "end_time": 2.569,
    "duration": 2.439,
    "timecode": "00:00:00,130 --> 00:00:02,569",
    "is_recovered": false
  },
  {
    "scene_id": 2,
    "text": "미국 무기를 이기고 있어요",
    "start_time": 3.149,
    "end_time": 4.23,
    "duration": 1.0810000000000004,
    "timecode": "00:00:03,149 --> 00:00:04,230",
    "is_recovered": false
  },
  {
    "scene_id": 3,
    "text": "나토 한복판에서요",
    "start_time": 4.629,
    "end_time": 5.849,
    "duration": 1.2200000000000006,
    "timecode": "00:00:04,628 --> 00:00:05,849",
    "is_recovered": false
  },
  {
    "scene_id": 4,
    "text": "2016년 1월 29일 노르웨이 국방부가 깜짝 발표를 했거든요",
    "start_time": 5.849,
    "end_time": 10.39,
    "duration": 4.541,
    "timecode": "00:00:05,849 --> 00:00:10,390",
    "is_recovered": false
  },
  {
    "scene_id": 5,
    "text": "차세대 장거리 정밀화력 체계사업자로",
    "start_time": 10.949,
    "end_time": 13.13,
    "duration": 2.181000000000001,
    "timecode": "00:00:10,948 --> 00:00:13,130",
    "is_recovered": false
  },
  {
    "scene_id": 6,
    "text": "한화 에어로스페이스를 선정했다고요",
    "start_time": 13.13,
    "end_time": 15.05,
    "duration": 1.92,
    "timecode": "00:00:13,130 --> 00:00:15,050",
    "is_recovered": false
  },
  {
    "scene_id": 7,
    "text": "규모가 얼마냐면요",
    "start_time": 15.05,
    "end_time": 16.589,
    "duration": 1.538999999999998,
    "timecode": "00:00:15,050 --> 00:00:16,588",
    "is_recovered": false
  },
  {
    "scene_id": 8,
    "text": "190억 크로네 우리 돈으로 2조 8천억 원이에요",
    "start_time": 16.589,
    "end_time": 19.629,
    "duration": 3.0400000000000027,
    "timecode": "00:00:16,588 --> 00:00:19,629",
    "is_recovered": false
  },
  {
    "scene_id": 9,
    "text": "근데 이게 왜 대단하냐",
    "start_time": 19.629,
    "end_time": 21.129,
    "duration": 1.5,
    "timecode": "00:00:19,629 --> 00:00:21,129",
    "is_recovered": false
  },
  {
    "scene_id": 10,
    "text": "자, 경쟁 상대가 누구였는지 아세요?",
    "start_time": 21.129,
    "end_time": 23.01,
    "duration": 1.8810000000000002,
    "timecode": "00:00:21,129 --> 00:00:23,010",
    "is_recovered": false
  },
  {
    "scene_id": 11,
    "text": "로키드 마틴이에요",
    "start_time": 23.469,
    "end_time": 24.289,
    "duration": 0.8200000000000003,
    "timecode": "00:00:23,469 --> 00:00:24,289",
    "is_recovered": false
  },
  {
    "scene_id": 12,
    "text": "하이마스 만드는 그 회사요",
    "start_time": 25.05,
    "end_time": 26.429,
    "duration": 1.3789999999999978,
    "timecode": "00:00:25,050 --> 00:00:26,428",
    "is_recovered": false
  },
  {
    "scene_id": 13,
    "text": "미국의 세계 1위 방산업체를",
    "start_time": 27.17,
    "end_time": 28.929,
    "duration": 1.7589999999999968,
    "timecode": "00:00:27,170 --> 00:00:28,928",
    "is_recovered": false
  },
  {
    "scene_id": 14,
    "text": "한국 회사가 정면으로 이긴 거예요",
    "start_time": 28.929,
    "end_time": 30.789,
    "duration": 1.860000000000003,
    "timecode": "00:00:28,928 --> 00:00:30,789",
    "is_recovered": false
  },
  {
    "scene_id": 15,
    "text": "나토 회원국당에서요",
    "start_time": 30.789,
    "end_time": 32.21,
    "duration": 1.4209999999999994,
    "timecode": "00:00:30,789 --> 00:00:32,210",
    "is_recovered": false
  },
  {
    "scene_id": 16,
    "text": "솔직히 저도 이거 조사하면서 좀 소름 돋았어요",
    "start_time": 32.21,
    "end_time": 34.63,
    "duration": 2.4200000000000017,
    "timecode": "00:00:32,210 --> 00:00:34,630",
    "is_recovered": false
  },
  {
    "scene_id": 17,
    "text": "한국 방산이 여기까지 왔구나",
    "start_time": 34.63,
    "end_time": 36.45,
    "duration": 1.8200000000000003,
    "timecode": "00:00:34,630 --> 00:00:36,450",
    "is_recovered": false
  },
  {
    "scene_id": 18,
    "text": "이런 생각이 들더라고요",
    "start_time": 36.45,
    "end_time": 37.829,
    "duration": 1.3789999999999978,
    "timecode": "00:00:36,450 --> 00:00:37,829",
    "is_recovered": false
  },
  {
    "scene_id": 19,
    "text": "자, 시작해 볼게요",
    "start_time": 37.829,
    "end_time": 39.45,
    "duration": 1.6210000000000022,
    "timecode": "00:00:37,829 --> 00:00:39,450",
    "is_recovered": false
  },
  {
    "scene_id": 20,
    "text": "자, 일단 배경부터 깔고 가야 해요",
    "start_time": 39.45,
    "end_time": 41.729,
    "duration": 2.2789999999999964,
    "timecode": "00:00:39,450 --> 00:00:41,728",
    "is_recovered": false
  },
  {
    "scene_id": 21,
    "text": "노르웨이가 왜 갑자기 미사일 사업을 시작했느냐면요",
    "start_time": 41.729,
    "end_time": 44.929,
    "duration": 3.200000000000003,
    "timecode": "00:00:41,728 --> 00:00:44,929",
    "is_recovered": false
  },
  {
    "scene_id": 22,
    "text": "2022년이에요",
    "start_time": 44.929,
    "end_time": 46.03,
    "duration": 1.100999999999999,
    "timecode": "00:00:44,929 --> 00:00:46,030",
    "is_recovered": false
  },
  {
    "scene_id": 23,
    "text": "러시아가 우크라이나 침공했잖아요",
    "start_time": 46.03,
    "end_time": 47.95,
    "duration": 1.9200000000000017,
    "timecode": "00:00:46,030 --> 00:00:47,950",
    "is_recovered": false
  },
  {
    "scene_id": 24,
    "text": "그때 유럽 전체가 펜이게 빠졌거든요",
    "start_time": 47.95,
    "end_time": 50.27,
    "duration": 2.3200000000000003,
    "timecode": "00:00:47,950 --> 00:00:50,270",
    "is_recovered": false
  },
  {
    "scene_id": 25,
    "text": "특히 노르웨이는요",
    "start_time": 50.59,
    "end_time": 51.89,
    "duration": 1.2999999999999972,
    "timecode": "00:00:50,590 --> 00:00:51,890",
    "is_recovered": false
  },
  {
    "scene_id": 26,
    "text": "러시아랑 국경을 맞대고 있어요",
    "start_time": 51.89,
    "end_time": 53.649,
    "duration": 1.7590000000000003,
    "timecode": "00:00:51,890 --> 00:00:53,649",
    "is_recovered": false
  },
  {
    "scene_id": 27,
    "text": "북극권 바로 미티에요",
    "start_time": 54.17,
    "end_time": 55.329,
    "duration": 1.158999999999999,
    "timecode": "00:00:54,170 --> 00:00:55,329",
    "is_recovered": false
  },
  {
    "scene_id": 28,
    "text": "근데 문제가 뭐였냐면요",
    "start_time": 55.329,
    "end_time": 57.049,
    "duration": 1.7199999999999989,
    "timecode": "00:00:55,329 --> 00:00:57,048",
    "is_recovered": false
  },
  {
    "scene_id": 29,
    "text": "노르웨이가 원래 쓰던 미국산",
    "start_time": 57.049,
    "end_time": 58.929,
    "duration": 1.8800000000000026,
    "timecode": "00:00:57,048 --> 00:00:58,929",
    "is_recovered": false
  },
  {
    "scene_id": 30,
    "text": "emi-70 다현장 로켓을 퇴혁시켰거든요",
    "start_time": 58.929,
    "end_time": 61.13,
    "duration": 2.2010000000000005,
    "timecode": "00:00:58,929 --> 00:01:01,130",
    "is_recovered": false
  },
  {
    "scene_id": 31,
    "text": "그러니까 장거리 화력이 턱빈 거예요",
    "start_time": 61.56,
    "end_time": 63.71,
    "duration": 2.1499999999999986,
    "timecode": "00:01:01,560 --> 00:01:03,710",
    "is_recovered": false
  },
  {
    "scene_id": 32,
    "text": "러시아 코앞인데 원거리 타격 수단이 없는 거죠",
    "start_time": 63.71,
    "end_time": 65.969,
    "duration": 2.2589999999999932,
    "timecode": "00:01:03,710 --> 00:01:05,968",
    "is_recovered": false
  },
  {
    "scene_id": 33,
    "text": "그래서 급하게 국제 입차를 시작한 거예요",
    "start_time": 65.969,
    "end_time": 69.95,
    "duration": 3.9810000000000088,
    "timecode": "00:01:05,968 --> 00:01:09,950",
    "is_recovered": false
  },
  {
    "scene_id": 34,
    "text": "2024년 말부터 본격적으로요",
    "start_time": 70.81,
    "end_time": 72.909,
    "duration": 2.0990000000000038,
    "timecode": "00:01:10,810 --> 00:01:12,909",
    "is_recovered": false
  },
  {
    "scene_id": 35,
    "text": "자, 그러면 경쟁이 어떻게 되었냐?",
    "start_time": 72.909,
    "end_time": 74.849,
    "duration": 1.9399999999999977,
    "timecode": "00:01:12,909 --> 00:01:14,849",
    "is_recovered": false
  },
  {
    "scene_id": 36,
    "text": "이 후보가 두 개였어요",
    "start_time": 74.849,
    "end_time": 76.569,
    "duration": 1.7199999999999989,
    "timecode": "00:01:14,849 --> 00:01:16,569",
    "is_recovered": false
  },
  {
    "scene_id": 37,
    "text": "미국, 로키드 마틴의 하이마스",
    "start_time": 77.07900000000001,
    "end_time": 79.28999999999999,
    "duration": 2.2109999999999843,
    "timecode": "00:01:17,079 --> 00:01:19,289",
    "is_recovered": false
  },
  {
    "scene_id": 38,
    "text": "그리고 한화여로 스페이스의 천무 하이마스요",
    "start_time": 79.28999999999999,
    "end_time": 82.75,
    "duration": 3.460000000000008,
    "timecode": "00:01:19,289 --> 00:01:22,750",
    "is_recovered": false
  },
  {
    "scene_id": 39,
    "text": "우크라이나 전쟁에서 엄청 유명해졌잖아요",
    "start_time": 82.75,
    "end_time": 85.09,
    "duration": 2.3400000000000034,
    "timecode": "00:01:22,750 --> 00:01:25,090",
    "is_recovered": false
  },
  {
    "scene_id": 40,
    "text": "러시아군 보금노 끊어버리고",
    "start_time": 85.65,
    "end_time": 87.189,
    "duration": 1.5389999999999873,
    "timecode": "00:01:25,650 --> 00:01:27,188",
    "is_recovered": false
  },
  {
    "scene_id": 41,
    "text": "탄약고 날려버리고",
    "start_time": 87.189,
    "end_time": 88.65,
    "duration": 1.4610000000000127,
    "timecode": "00:01:27,188 --> 00:01:28,650",
    "is_recovered": false
  },
  {
    "scene_id": 42,
    "text": "유튜브에 영상 엄청 많잖아요",
    "start_time": 88.65,
    "end_time": 90.349,
    "duration": 1.698999999999998,
    "timecode": "00:01:28,650 --> 00:01:30,349",
    "is_recovered": false
  },
  {
    "scene_id": 43,
    "text": "그래서 다들 당연히 하이마스가 이길 줄 알았어요",
    "start_time": 90.349,
    "end_time": 93.43,
    "duration": 3.081000000000003,
    "timecode": "00:01:30,349 --> 00:01:33,430",
    "is_recovered": false
  },
  {
    "scene_id": 44,
    "text": "나토 동맹국이 미국 무기 사는 게 당연하니까요",
    "start_time": 93.43,
    "end_time": 96.489,
    "duration": 3.0589999999999975,
    "timecode": "00:01:33,430 --> 00:01:36,489",
    "is_recovered": false
  },
  {
    "scene_id": 45,
    "text": "근데요, 결과는 뒤집혔어요",
    "start_time": 96.489,
    "end_time": 98.709,
    "duration": 2.219999999999999,
    "timecode": "00:01:36,489 --> 00:01:38,709",
    "is_recovered": false
  },
  {
    "scene_id": 46,
    "text": "노르웨이가 천무를 선택한 거예요",
    "start_time": 98.709,
    "end_time": 100.45,
    "duration": 1.7409999999999997,
    "timecode": "00:01:38,709 --> 00:01:40,450",
    "is_recovered": false
  },
  {
    "scene_id": 47,
    "text": "왜 그랬을까요?",
    "start_time": 100.45,
    "end_time": 101.15,
    "duration": 0.7000000000000028,
    "timecode": "00:01:40,450 --> 00:01:41,150",
    "is_recovered": false
  },
  {
    "scene_id": 48,
    "text": "첫 번째, 화력이에요",
    "start_time": 101.89,
    "end_time": 103.22999999999999,
    "duration": 1.3399999999999892,
    "timecode": "00:01:41,890 --> 00:01:43,229",
    "is_recovered": false
  },
  {
    "scene_id": 49,
    "text": "하이마스는 발사대가 하나예요",
    "start_time": 103.22999999999999,
    "end_time": 105.069,
    "duration": 1.8390000000000128,
    "timecode": "00:01:43,229 --> 00:01:45,069",
    "is_recovered": false
  },
  {
    "scene_id": 50,
    "text": "로켓 6발 들어가요",
    "start_time": 105.069,
    "end_time": 106.65,
    "duration": 1.581000000000003,
    "timecode": "00:01:45,069 --> 00:01:46,650",
    "is_recovered": false
  },
  {
    "scene_id": 51,
    "text": "천무는요, 발사대가 2개에요",
    "start_time": 106.65,
    "end_time": 108.65,
    "duration": 2.0,
    "timecode": "00:01:46,650 --> 00:01:48,650",
    "is_recovered": false
  },
  {
    "scene_id": 52,
    "text": "로켓 12발 들어가요",
    "start_time": 108.65,
    "end_time": 110.31,
    "duration": 1.6599999999999966,
    "timecode": "00:01:48,650 --> 00:01:50,310",
    "is_recovered": false
  },
  {
    "scene_id": 53,
    "text": "같은 시간에 2배를 쏠 수 있는 거예요",
    "start_time": 110.31,
    "end_time": 112.31,
    "duration": 2.0,
    "timecode": "00:01:50,310 --> 00:01:52,310",
    "is_recovered": false
  },
  {
    "scene_id": 54,
    "text": "전쟁터에서 화력이 2배면요",
    "start_time": 112.969,
    "end_time": 114.53,
    "duration": 1.561000000000007,
    "timecode": "00:01:52,968 --> 00:01:54,530",
    "is_recovered": false
  },
  {
    "scene_id": 55,
    "text": "그건 그냥 다른 무기예요",
    "start_time": 114.53,
    "end_time": 116.069,
    "duration": 1.5390000000000015,
    "timecode": "00:01:54,530 --> 00:01:56,069",
    "is_recovered": false
  },
  {
    "scene_id": 56,
    "text": "두 번째, 사거리에요",
    "start_time": 116.069,
    "end_time": 117.95,
    "duration": 1.8810000000000002,
    "timecode": "00:01:56,069 --> 00:01:57,950",
    "is_recovered": false
  },
  {
    "scene_id": 57,
    "text": "노르웨이가 뭘 원했으냐면요",
    "start_time": 118.45,
    "end_time": 120.29,
    "duration": 1.8400000000000034,
    "timecode": "00:01:58,450 --> 00:02:00,290",
    "is_recovered": false
  },
  {
    "scene_id": 58,
    "text": "적종심 깊숙이 때릴 수 있는 능력이에요",
    "start_time": 120.29,
    "end_time": 122.53,
    "duration": 2.239999999999995,
    "timecode": "00:02:00,290 --> 00:02:02,530",
    "is_recovered": false
  },
  {
    "scene_id": 59,
    "text": "러시아 미사일 발사대를 먼저 부셔야 하니까요",
    "start_time": 122.53,
    "end_time": 125.189,
    "duration": 2.658999999999992,
    "timecode": "00:02:02,530 --> 00:02:05,188",
    "is_recovered": false
  },
  {
    "scene_id": 60,
    "text": "한화가 뭘 제시했으냐면요",
    "start_time": 125.189,
    "end_time": 127.31,
    "duration": 2.1210000000000093,
    "timecode": "00:02:05,188 --> 00:02:07,310",
    "is_recovered": false
  },
  {
    "scene_id": 61,
    "text": "500km에요",
    "start_time": 127.31,
    "end_time": 128.65,
    "duration": 1.3400000000000034,
    "timecode": "00:02:07,310 --> 00:02:08,650",
    "is_recovered": false
  },
  {
    "scene_id": 62,
    "text": "기존 290km짜리를 넘어서",
    "start_time": 128.65,
    "end_time": 131.069,
    "duration": 2.4189999999999827,
    "timecode": "00:02:08,650 --> 00:02:11,068",
    "is_recovered": false
  },
  {
    "scene_id": 63,
    "text": "500km까지 쏠 수 있다라고 한 거예요",
    "start_time": 131.069,
    "end_time": 133.569,
    "duration": 2.5,
    "timecode": "00:02:11,068 --> 00:02:13,568",
    "is_recovered": false
  },
  {
    "scene_id": 64,
    "text": "서울에서 부산보다 먼 거리를 정밀타격하는 거예요",
    "start_time": 134.25,
    "end_time": 136.81,
    "duration": 2.5600000000000023,
    "timecode": "00:02:14,250 --> 00:02:16,810",
    "is_recovered": false
  },
  {
    "scene_id": 65,
    "text": "5차 범위가 얼마냐면요",
    "start_time": 136.81,
    "end_time": 138.789,
    "duration": 1.978999999999985,
    "timecode": "00:02:16,810 --> 00:02:18,788",
    "is_recovered": false
  },
  {
    "scene_id": 66,
    "text": "9에서 15m에요",
    "start_time": 138.789,
    "end_time": 140.22899999999998,
    "duration": 1.4399999999999977,
    "timecode": "00:02:18,788 --> 00:02:20,228",
    "is_recovered": false
  },
  {
    "scene_id": 67,
    "text": "축구 골대 크기 안에 떨어진다는 거예요",
    "start_time": 140.22899999999998,
    "end_time": 142.03,
    "duration": 1.8010000000000161,
    "timecode": "00:02:20,228 --> 00:02:22,030",
    "is_recovered": false
  },
  {
    "scene_id": 68,
    "text": "세 번째, 납기에요",
    "start_time": 142.03,
    "end_time": 143.65,
    "duration": 1.6200000000000045,
    "timecode": "00:02:22,030 --> 00:02:23,650",
    "is_recovered": false
  },
  {
    "scene_id": 69,
    "text": "하이마스는요, 지금 주문이 밀려 있어요",
    "start_time": 143.65,
    "end_time": 146.25,
    "duration": 2.5999999999999943,
    "timecode": "00:02:23,650 --> 00:02:26,250",
    "is_recovered": false
  },
  {
    "scene_id": 70,
    "text": "우크라이나, 폴란드, 대만, 호주",
    "start_time": 146.25,
    "end_time": 148.00900000000001,
    "duration": 1.7590000000000146,
    "timecode": "00:02:26,250 --> 00:02:28,009",
    "is_recovered": false
  },
  {
    "scene_id": 71,
    "text": "전 세계에서 사겠다라고 줄 서 있거든요",
    "start_time": 148.00900000000001,
    "end_time": 149.87,
    "duration": 1.86099999999999,
    "timecode": "00:02:28,009 --> 00:02:29,870",
    "is_recovered": false
  },
  {
    "scene_id": 72,
    "text": "그래서 노르웨이한테 언제 줄 수 있냐고 하니까요",
    "start_time": 149.87,
    "end_time": 152.93,
    "duration": 3.0600000000000023,
    "timecode": "00:02:29,870 --> 00:02:32,930",
    "is_recovered": false
  },
  {
    "scene_id": 73,
    "text": "로키드 마틴이 명확한 답을 못 한 거예요",
    "start_time": 152.93,
    "end_time": 155.21,
    "duration": 2.280000000000001,
    "timecode": "00:02:32,930 --> 00:02:35,210",
    "is_recovered": false
  },
  {
    "scene_id": 74,
    "text": "근데 한화는요",
    "start_time": 155.21,
    "end_time": 156.31,
    "duration": 1.0999999999999943,
    "timecode": "00:02:35,210 --> 00:02:36,310",
    "is_recovered": false
  },
  {
    "scene_id": 75,
    "text": "2028년부터 인도 시작한다고 딱 약속한 거예요",
    "start_time": 156.31,
    "end_time": 159.72899999999998,
    "duration": 3.4189999999999827,
    "timecode": "00:02:36,310 --> 00:02:39,728",
    "is_recovered": false
  },
  {
    "scene_id": 76,
    "text": "그리고요, 결정타가 있었어요",
    "start_time": 159.72899999999998,
    "end_time": 161.82999999999998,
    "duration": 2.100999999999999,
    "timecode": "00:02:39,728 --> 00:02:41,829",
    "is_recovered": false
  },
  {
    "scene_id": 77,
    "text": "산업협력이에요",
    "start_time": 161.82999999999998,
    "end_time": 162.93,
    "duration": 1.1000000000000227,
    "timecode": "00:02:41,829 --> 00:02:42,930",
    "is_recovered": false
  },
  {
    "scene_id": 78,
    "text": "오프셋이라고도 하는데요",
    "start_time": 162.93,
    "end_time": 164.349,
    "duration": 1.4189999999999827,
    "timecode": "00:02:42,930 --> 00:02:44,348",
    "is_recovered": false
  },
  {
    "scene_id": 79,
    "text": "한화가 뭘 제안해서 했냐면요",
    "start_time": 165.00900000000001,
    "end_time": 166.949,
    "duration": 1.9399999999999977,
    "timecode": "00:02:45,009 --> 00:02:46,949",
    "is_recovered": false
  },
  {
    "scene_id": 80,
    "text": "계약 금액의 120%를 노르웨이에 재투자하겠다고 한 거예요",
    "start_time": 166.949,
    "end_time": 170.56900000000002,
    "duration": 3.6200000000000045,
    "timecode": "00:02:46,949 --> 00:02:50,569",
    "is_recovered": false
  },
  {
    "scene_id": 81,
    "text": "2조 8천억 계약인데",
    "start_time": 171.03,
    "end_time": 172.22899999999998,
    "duration": 1.1989999999999839,
    "timecode": "00:02:51,030 --> 00:02:52,228",
    "is_recovered": false
  },
  {
    "scene_id": 82,
    "text": "3조 넘게 노르웨이에 돌려주겠다는 거예요",
    "start_time": 172.22899999999998,
    "end_time": 174.50900000000001,
    "duration": 2.2800000000000296,
    "timecode": "00:02:52,228 --> 00:02:54,509",
    "is_recovered": false
  },
  {
    "scene_id": 83,
    "text": "이게 무슨 말이냐면요",
    "start_time": 174.50900000000001,
    "end_time": 175.66899999999998,
    "duration": 1.1599999999999682,
    "timecode": "00:02:54,509 --> 00:02:55,668",
    "is_recovered": false
  },
  {
    "scene_id": 84,
    "text": "노르웨이 방산업체랑 같이 일하고",
    "start_time": 175.66899999999998,
    "end_time": 177.789,
    "duration": 2.1200000000000045,
    "timecode": "00:02:55,668 --> 00:02:57,788",
    "is_recovered": false
  },
  {
    "scene_id": 85,
    "text": "현지의 공장 짓고 일자리 만들어주겠다는 거예요",
    "start_time": 177.789,
    "end_time": 180.87,
    "duration": 3.0810000000000173,
    "timecode": "00:02:57,788 --> 00:03:00,870",
    "is_recovered": false
  },
  {
    "scene_id": 86,
    "text": "콩스버그라고 노르웨이 최대 방산업체가 있거든요",
    "start_time": 180.87,
    "end_time": 183.59,
    "duration": 2.719999999999999,
    "timecode": "00:03:00,870 --> 00:03:03,590",
    "is_recovered": false
  },
  {
    "scene_id": 87,
    "text": "여기랑 이미 2024년에 협력 계약을 맺었어요",
    "start_time": 184.099,
    "end_time": 187.449,
    "duration": 3.3500000000000227,
    "timecode": "00:03:04,098 --> 00:03:07,449",
    "is_recovered": false
  },
  {
    "scene_id": 88,
    "text": "남모라는 탄약 회사랑도 손잡았고요",
    "start_time": 187.449,
    "end_time": 189.889,
    "duration": 2.4399999999999977,
    "timecode": "00:03:07,449 --> 00:03:09,889",
    "is_recovered": false
  },
  {
    "scene_id": 89,
    "text": "그냥 무기 팔고 끝나는 게 아니라",
    "start_time": 189.889,
    "end_time": 191.71,
    "duration": 1.820999999999998,
    "timecode": "00:03:09,889 --> 00:03:11,710",
    "is_recovered": false
  },
  {
    "scene_id": 90,
    "text": "노르웨이 방산 생태계에 들어간 거예요",
    "start_time": 191.71,
    "end_time": 193.93,
    "duration": 2.219999999999999,
    "timecode": "00:03:11,710 --> 00:03:13,930",
    "is_recovered": false
  },
  {
    "scene_id": 91,
    "text": "근데요, 이게 다가 아니에요",
    "start_time": 193.93,
    "end_time": 195.49,
    "duration": 1.5600000000000023,
    "timecode": "00:03:13,930 --> 00:03:15,490",
    "is_recovered": false
  },
  {
    "scene_id": 92,
    "text": "진짜 승부수는 따로 있었어요",
    "start_time": 195.49,
    "end_time": 197.21,
    "duration": 1.7199999999999989,
    "timecode": "00:03:15,490 --> 00:03:17,210",
    "is_recovered": false
  },
  {
    "scene_id": 93,
    "text": "2025년 10월에 무슨 일이 있었냐면요",
    "start_time": 197.21,
    "end_time": 200.03,
    "duration": 2.819999999999993,
    "timecode": "00:03:17,210 --> 00:03:20,030",
    "is_recovered": false
  },
  {
    "scene_id": 94,
    "text": "강훈식 대통령 비서실장이 노르웨이로 날아갔어요",
    "start_time": 200.03,
    "end_time": 202.61,
    "duration": 2.5800000000000125,
    "timecode": "00:03:20,030 --> 00:03:22,610",
    "is_recovered": false
  },
  {
    "scene_id": 95,
    "text": "대통령 특사 자격으로요",
    "start_time": 202.61,
    "end_time": 203.99,
    "duration": 1.3799999999999955,
    "timecode": "00:03:22,610 --> 00:03:23,990",
    "is_recovered": false
  },
  {
    "scene_id": 96,
    "text": "이재명 대통령 친서를 들고요",
    "start_time": 203.99,
    "end_time": 205.949,
    "duration": 1.9590000000000032,
    "timecode": "00:03:23,990 --> 00:03:25,949",
    "is_recovered": false
  },
  {
    "scene_id": 97,
    "text": "노르웨이 총리랑 국방부 장관이랑 직접 만났어요",
    "start_time": 205.949,
    "end_time": 208.81,
    "duration": 2.86099999999999,
    "timecode": "00:03:25,949 --> 00:03:28,810",
    "is_recovered": false
  },
  {
    "scene_id": 98,
    "text": "이게 뭘 의미하냐면요",
    "start_time": 208.81,
    "end_time": 210.22899999999998,
    "duration": 1.4189999999999827,
    "timecode": "00:03:28,810 --> 00:03:30,228",
    "is_recovered": false
  },
  {
    "scene_id": 99,
    "text": "무기 파는 게 아니라 국가대 국가로 손잡자는 거예요",
    "start_time": 210.22899999999998,
    "end_time": 213.05,
    "duration": 2.8210000000000264,
    "timecode": "00:03:30,228 --> 00:03:33,050",
    "is_recovered": false
  },
  {
    "scene_id": 100,
    "text": "미국이 나토 동맹이니까 무조건 이긴다",
    "start_time": 213.629,
    "end_time": 215.61,
    "duration": 1.981000000000023,
    "timecode": "00:03:33,628 --> 00:03:35,610",
    "is_recovered": false
  },
  {
    "scene_id": 101,
    "text": "한국은 그 공식을 외교로 깨버린 거예요",
    "start_time": 215.61,
    "end_time": 217.99,
    "duration": 2.3799999999999955,
    "timecode": "00:03:35,610 --> 00:03:37,990",
    "is_recovered": false
  },
  {
    "scene_id": 102,
    "text": "업계에서는 이걸 팀 코리아의 승리라고 불러요",
    "start_time": 217.99,
    "end_time": 220.969,
    "duration": 2.978999999999985,
    "timecode": "00:03:37,990 --> 00:03:40,968",
    "is_recovered": false
  },
  {
    "scene_id": 103,
    "text": "자 그러면 계약 내용을 좀 뜯어볼게요",
    "start_time": 220.969,
    "end_time": 222.849,
    "duration": 1.8799999999999955,
    "timecode": "00:03:40,968 --> 00:03:42,848",
    "is_recovered": false
  },
  {
    "scene_id": 104,
    "text": "2조 8천억 원이잖아요",
    "start_time": 223.31,
    "end_time": 224.53,
    "duration": 1.2199999999999989,
    "timecode": "00:03:43,310 --> 00:03:44,530",
    "is_recovered": false
  },
  {
    "scene_id": 105,
    "text": "근데 이게 다 무기값이 아니에요",
    "start_time": 224.53,
    "end_time": 225.93,
    "duration": 1.4000000000000057,
    "timecode": "00:03:44,530 --> 00:03:45,930",
    "is_recovered": false
  },
  {
    "scene_id": 106,
    "text": "천무 발사대 16대랑 초기 탄약이요",
    "start_time": 225.93,
    "end_time": 228.37,
    "duration": 2.4399999999999977,
    "timecode": "00:03:45,930 --> 00:03:48,370",
    "is_recovered": false
  },
  {
    "scene_id": 107,
    "text": "1조 원 정도예요",
    "start_time": 228.37,
    "end_time": 229.71,
    "duration": 1.3400000000000034,
    "timecode": "00:03:48,370 --> 00:03:49,710",
    "is_recovered": false
  },
  {
    "scene_id": 108,
    "text": "나머지 1조 8천억은 뭐냐면요",
    "start_time": 229.71,
    "end_time": 231.81,
    "duration": 2.0999999999999943,
    "timecode": "00:03:49,710 --> 00:03:51,810",
    "is_recovered": false
  },
  {
    "scene_id": 109,
    "text": "정비시설 훈련센터 군수지원 인프라에요",
    "start_time": 231.81,
    "end_time": 235.25,
    "duration": 3.4399999999999977,
    "timecode": "00:03:51,810 --> 00:03:55,250",
    "is_recovered": false
  },
  {
    "scene_id": 110,
    "text": "이게 왜 중요하냐면요",
    "start_time": 235.25,
    "end_time": 237.05,
    "duration": 1.8000000000000114,
    "timecode": "00:03:55,250 --> 00:03:57,050",
    "is_recovered": false
  },
  {
    "scene_id": 111,
    "text": "무기는 한 번 팔면 끝이에요",
    "start_time": 237.05,
    "end_time": 238.689,
    "duration": 1.6389999999999816,
    "timecode": "00:03:57,050 --> 00:03:58,688",
    "is_recovered": false
  },
  {
    "scene_id": 112,
    "text": "근데 정비랑 군수지원은요",
    "start_time": 238.87,
    "end_time": 240.81,
    "duration": 1.9399999999999977,
    "timecode": "00:03:58,870 --> 00:04:00,810",
    "is_recovered": false
  },
  {
    "scene_id": 113,
    "text": "20년 30년 계속 돈이 들어와요",
    "start_time": 240.81,
    "end_time": 243.71,
    "duration": 2.9000000000000057,
    "timecode": "00:04:00,810 --> 00:04:03,710",
    "is_recovered": false
  },
  {
    "scene_id": 114,
    "text": "매년 부품 바꾸고 탄약 채우고 업그레이드 해줘야 하니까요",
    "start_time": 243.71,
    "end_time": 247.629,
    "duration": 3.9189999999999827,
    "timecode": "00:04:03,710 --> 00:04:07,628",
    "is_recovered": false
  },
  {
    "scene_id": 115,
    "text": "그래서 증권가에서 뭐라고 하냐면요",
    "start_time": 247.629,
    "end_time": 250.469,
    "duration": 2.8400000000000034,
    "timecode": "00:04:07,628 --> 00:04:10,468",
    "is_recovered": false
  },
  {
    "scene_id": 116,
    "text": "네 한화가 일회성 수주 기업에서",
    "start_time": 250.469,
    "end_time": 253.169,
    "duration": 2.700000000000017,
    "timecode": "00:04:10,468 --> 00:04:13,169",
    "is_recovered": false
  },
  {
    "scene_id": 117,
    "text": "유럽의 거점 방산 파트너로 바뀌었다고요",
    "start_time": 253.169,
    "end_time": 256.189,
    "duration": 3.0200000000000102,
    "timecode": "00:04:13,169 --> 00:04:16,189",
    "is_recovered": false
  },
  {
    "scene_id": 118,
    "text": "리레이팅이 됐다라는 거예요",
    "start_time": 256.189,
    "end_time": 257.81,
    "duration": 1.620999999999981,
    "timecode": "00:04:16,189 --> 00:04:17,810",
    "is_recovered": false
  },
  {
    "scene_id": 119,
    "text": "근데요",
    "start_time": 257.81,
    "end_time": 258.41,
    "duration": 0.6000000000000227,
    "timecode": "00:04:17,810 --> 00:04:18,410",
    "is_recovered": false
  },
  {
    "scene_id": 120,
    "text": "노르웨이만 있는 게 아니에요",
    "start_time": 258.41,
    "end_time": 260.009,
    "duration": 1.5989999999999895,
    "timecode": "00:04:18,410 --> 00:04:20,009",
    "is_recovered": false
  },
  {
    "scene_id": 121,
    "text": "지도를 한 번 펼쳐볼게요",
    "start_time": 260.009,
    "end_time": 261.41,
    "duration": 1.4010000000000105,
    "timecode": "00:04:20,009 --> 00:04:21,410",
    "is_recovered": false
  },
  {
    "scene_id": 122,
    "text": "폴란드요",
    "start_time": 262.129,
    "end_time": 262.75,
    "duration": 0.6209999999999809,
    "timecode": "00:04:22,129 --> 00:04:22,750",
    "is_recovered": false
  },
  {
    "scene_id": 123,
    "text": "천무 290대 도입하기로 했어요",
    "start_time": 262.75,
    "end_time": 264.85,
    "duration": 2.1000000000000227,
    "timecode": "00:04:22,750 --> 00:04:24,850",
    "is_recovered": false
  },
  {
    "scene_id": 124,
    "text": "에스톤이아요",
    "start_time": 265.449,
    "end_time": 266.31,
    "duration": 0.86099999999999,
    "timecode": "00:04:25,449 --> 00:04:26,310",
    "is_recovered": false
  },
  {
    "scene_id": 125,
    "text": "천무 6대 계약했어요",
    "start_time": 266.31,
    "end_time": 267.689,
    "duration": 1.379000000000019,
    "timecode": "00:04:26,310 --> 00:04:27,689",
    "is_recovered": false
  },
  {
    "scene_id": 126,
    "text": "2025년 12월에는 폴란드에서 뭘 했었냐면요",
    "start_time": 268.37,
    "end_time": 271.61,
    "duration": 3.240000000000009,
    "timecode": "00:04:28,370 --> 00:04:31,610",
    "is_recovered": false
  },
  {
    "scene_id": 127,
    "text": "140억 주어티",
    "start_time": 271.61,
    "end_time": 272.79,
    "duration": 1.1800000000000068,
    "timecode": "00:04:31,610 --> 00:04:32,790",
    "is_recovered": false
  },
  {
    "scene_id": 128,
    "text": "우리 돈 사조 6천억 원 규모로",
    "start_time": 272.79,
    "end_time": 274.87,
    "duration": 2.079999999999984,
    "timecode": "00:04:32,790 --> 00:04:34,870",
    "is_recovered": false
  },
  {
    "scene_id": 129,
    "text": "탄약 현지 생산 계약을 맺었어요",
    "start_time": 274.87,
    "end_time": 276.509,
    "duration": 1.63900000000001,
    "timecode": "00:04:34,870 --> 00:04:36,509",
    "is_recovered": false
  },
  {
    "scene_id": 130,
    "text": "폴란드에 공장지어서 미사일 찍겠다라는 거예요",
    "start_time": 276.509,
    "end_time": 279.149,
    "duration": 2.6399999999999864,
    "timecode": "00:04:36,509 --> 00:04:39,149",
    "is_recovered": false
  },
  {
    "scene_id": 131,
    "text": "그러면 이 미사일이 어디로 가겠어요",
    "start_time": 279.149,
    "end_time": 280.889,
    "duration": 1.740000000000009,
    "timecode": "00:04:39,149 --> 00:04:40,889",
    "is_recovered": false
  },
  {
    "scene_id": 132,
    "text": "노르웨이로, 에스톤이야로",
    "start_time": 280.889,
    "end_time": 282.629,
    "duration": 1.740000000000009,
    "timecode": "00:04:40,889 --> 00:04:42,629",
    "is_recovered": false
  },
  {
    "scene_id": 133,
    "text": "다른 유럽 국가로 가는 거예요",
    "start_time": 282.629,
    "end_time": 284.149,
    "duration": 1.5199999999999818,
    "timecode": "00:04:42,629 --> 00:04:44,149",
    "is_recovered": false
  },
  {
    "scene_id": 134,
    "text": "물류비 줄이고 공급 안정성 높이고",
    "start_time": 284.149,
    "end_time": 286.589,
    "duration": 2.4399999999999977,
    "timecode": "00:04:44,149 --> 00:04:46,588",
    "is_recovered": false
  },
  {
    "scene_id": 135,
    "text": "유럽 안에서 유럽을 위한 무기를 만드는 거예요",
    "start_time": 286.589,
    "end_time": 289.009,
    "duration": 2.420000000000016,
    "timecode": "00:04:46,588 --> 00:04:49,009",
    "is_recovered": false
  },
  {
    "scene_id": 136,
    "text": "그리고요",
    "start_time": 289.009,
    "end_time": 289.769,
    "duration": 0.7599999999999909,
    "timecode": "00:04:49,009 --> 00:04:49,769",
    "is_recovered": false
  },
  {
    "scene_id": 137,
    "text": "노르웨이에는 이미 한화 무기가 있어요",
    "start_time": 289.769,
    "end_time": 291.79,
    "duration": 2.021000000000015,
    "timecode": "00:04:49,769 --> 00:04:51,790",
    "is_recovered": false
  },
  {
    "scene_id": 138,
    "text": "그이나 인제주 보여요",
    "start_time": 291.79,
    "end_time": 293.089,
    "duration": 1.2989999999999782,
    "timecode": "00:04:51,790 --> 00:04:53,088",
    "is_recovered": false
  },
  {
    "scene_id": 139,
    "text": "노르웨이에서는 비달을 하고 불러요",
    "start_time": 293.089,
    "end_time": 294.709,
    "duration": 1.6200000000000045,
    "timecode": "00:04:53,088 --> 00:04:54,709",
    "is_recovered": false
  },
  {
    "scene_id": 140,
    "text": "이게 주력포병 화력이에요",
    "start_time": 294.709,
    "end_time": 296.009,
    "duration": 1.3000000000000114,
    "timecode": "00:04:54,709 --> 00:04:56,009",
    "is_recovered": false
  },
  {
    "scene_id": 141,
    "text": "근데 여기에 천무까지 들어가면요",
    "start_time": 296.009,
    "end_time": 297.87,
    "duration": 1.86099999999999,
    "timecode": "00:04:56,009 --> 00:04:57,870",
    "is_recovered": false
  },
  {
    "scene_id": 142,
    "text": "자주포랑 다연장 로켓이 같은 회사 제품이 되는 거예요",
    "start_time": 297.87,
    "end_time": 300.769,
    "duration": 2.899000000000001,
    "timecode": "00:04:57,870 --> 00:05:00,769",
    "is_recovered": false
  },
  {
    "scene_id": 143,
    "text": "정비도 편하고 훈련도 편하고 부품도 공유할 수 있어요",
    "start_time": 300.769,
    "end_time": 304.49,
    "duration": 3.7210000000000036,
    "timecode": "00:05:00,769 --> 00:05:04,490",
    "is_recovered": false
  },
  {
    "scene_id": 144,
    "text": "노르웨이 입장에서는 완전 효율적인 거죠",
    "start_time": 304.49,
    "end_time": 306.81,
    "duration": 2.319999999999993,
    "timecode": "00:05:04,490 --> 00:05:06,810",
    "is_recovered": false
  },
  {
    "scene_id": 145,
    "text": "자 지금까지 유럽 얘기해서 했는데요",
    "start_time": 307.18,
    "end_time": 309.329,
    "duration": 2.149000000000001,
    "timecode": "00:05:07,180 --> 00:05:09,329",
    "is_recovered": false
  },
  {
    "scene_id": 146,
    "text": "진짜 대박은 따로 있어요",
    "start_time": 309.329,
    "end_time": 311.11,
    "duration": 1.781000000000006,
    "timecode": "00:05:09,329 --> 00:05:11,110",
    "is_recovered": false
  },
  {
    "scene_id": 147,
    "text": "미국이에요",
    "start_time": 311.11,
    "end_time": 311.81,
    "duration": 0.6999999999999886,
    "timecode": "00:05:11,110 --> 00:05:11,810",
    "is_recovered": false
  },
  {
    "scene_id": 148,
    "text": "노르웨이 수주 발표 나온 그 시점이에요",
    "start_time": 312.35,
    "end_time": 314.209,
    "duration": 1.8589999999999804,
    "timecode": "00:05:12,350 --> 00:05:14,209",
    "is_recovered": false
  },
  {
    "scene_id": 149,
    "text": "한화가 미국에서 뭘 했으냐면요",
    "start_time": 314.75,
    "end_time": 316.829,
    "duration": 2.0790000000000077,
    "timecode": "00:05:14,750 --> 00:05:16,829",
    "is_recovered": false
  },
  {
    "scene_id": 150,
    "text": "아카소주파인 블러프의 탄약 공장을 짓기로 했어요",
    "start_time": 316.829,
    "end_time": 319.85,
    "duration": 3.021000000000015,
    "timecode": "00:05:16,829 --> 00:05:19,850",
    "is_recovered": false
  },
  {
    "scene_id": 151,
    "text": "투자 규모가 1억 3천만 달러에요",
    "start_time": 320.329,
    "end_time": 322.85,
    "duration": 2.521000000000015,
    "timecode": "00:05:20,329 --> 00:05:22,850",
    "is_recovered": false
  },
  {
    "scene_id": 152,
    "text": "미국 6군이랑 직접 계약한 거예요",
    "start_time": 322.85,
    "end_time": 324.99,
    "duration": 2.1399999999999864,
    "timecode": "00:05:22,850 --> 00:05:24,990",
    "is_recovered": false
  },
  {
    "scene_id": 153,
    "text": "155mm 포탄 원료랑 추진제를 미국당에서 만들겠다는 거예요",
    "start_time": 325.569,
    "end_time": 329.75,
    "duration": 4.180999999999983,
    "timecode": "00:05:25,569 --> 00:05:29,750",
    "is_recovered": false
  },
  {
    "scene_id": 154,
    "text": "미국이 지금 탄약이 부족해요",
    "start_time": 331.329,
    "end_time": 333.149,
    "duration": 1.8199999999999932,
    "timecode": "00:05:31,329 --> 00:05:33,149",
    "is_recovered": false
  },
  {
    "scene_id": 155,
    "text": "제 우크라이나 지원하느라 제거가 바닥 났거든요",
    "start_time": 333.149,
    "end_time": 335.47,
    "duration": 2.3210000000000264,
    "timecode": "00:05:33,149 --> 00:05:35,470",
    "is_recovered": false
  },
  {
    "scene_id": 156,
    "text": "근데 미국 내 생산 능력이 부족한 거예요",
    "start_time": 335.47,
    "end_time": 337.709,
    "duration": 2.238999999999976,
    "timecode": "00:05:35,470 --> 00:05:37,709",
    "is_recovered": false
  },
  {
    "scene_id": 157,
    "text": "그래서 한화한테 들어오라고 한 거예요",
    "start_time": 337.709,
    "end_time": 340.31,
    "duration": 2.600999999999999,
    "timecode": "00:05:37,709 --> 00:05:40,310",
    "is_recovered": false
  },
  {
    "scene_id": 158,
    "text": "트럼프 대통령이 뭐라고 하죠",
    "start_time": 340.31,
    "end_time": 341.75,
    "duration": 1.4399999999999977,
    "timecode": "00:05:40,310 --> 00:05:41,750",
    "is_recovered": false
  },
  {
    "scene_id": 159,
    "text": "메이드인 아메리카 자국 생산 중시 하잖아요",
    "start_time": 341.75,
    "end_time": 345.29,
    "duration": 3.5400000000000205,
    "timecode": "00:05:41,750 --> 00:05:45,290",
    "is_recovered": false
  },
  {
    "scene_id": 160,
    "text": "근데 한화가 미국의 공장지으면요",
    "start_time": 345.29,
    "end_time": 348.29,
    "duration": 3.0,
    "timecode": "00:05:45,290 --> 00:05:48,290",
    "is_recovered": false
  },
  {
    "scene_id": 161,
    "text": "미국 입장에서는 현지 기업이 되는 거예요",
    "start_time": 348.29,
    "end_time": 350.35,
    "duration": 2.0600000000000023,
    "timecode": "00:05:48,290 --> 00:05:50,350",
    "is_recovered": false
  },
  {
    "scene_id": 162,
    "text": "나중에 미국 6군 사업에도 참여할 수 있는 거죠",
    "start_time": 350.35,
    "end_time": 352.649,
    "duration": 2.298999999999978,
    "timecode": "00:05:50,350 --> 00:05:52,649",
    "is_recovered": false
  },
  {
    "scene_id": 163,
    "text": "자 정리해 볼게요",
    "start_time": 352.99,
    "end_time": 354.31,
    "duration": 1.3199999999999932,
    "timecode": "00:05:52,990 --> 00:05:54,310",
    "is_recovered": false
  },
  {
    "scene_id": 164,
    "text": "한화 여로 스페이스가 지금 뭘 갖고 있냐면요",
    "start_time": 354.99,
    "end_time": 357.509,
    "duration": 2.5190000000000055,
    "timecode": "00:05:54,990 --> 00:05:57,509",
    "is_recovered": false
  },
  {
    "scene_id": 165,
    "text": "노르웨이, 폴란드, 에스톤이야, 루마니아",
    "start_time": 357.509,
    "end_time": 360.79,
    "duration": 3.281000000000006,
    "timecode": "00:05:57,509 --> 00:06:00,790",
    "is_recovered": false
  },
  {
    "scene_id": 166,
    "text": "유럽 동쪽에서 북쪽까지 한화 무기가 깔리고 있어요",
    "start_time": 360.79,
    "end_time": 363.85,
    "duration": 3.0600000000000023,
    "timecode": "00:06:00,790 --> 00:06:03,850",
    "is_recovered": false
  },
  {
    "scene_id": 167,
    "text": "그리고 미국의 생산 거점까지 확보하는 중이에요",
    "start_time": 363.85,
    "end_time": 367.149,
    "duration": 3.298999999999978,
    "timecode": "00:06:03,850 --> 00:06:07,149",
    "is_recovered": false
  },
  {
    "scene_id": 168,
    "text": "2024년 수주 장호가 역대 최대예요",
    "start_time": 367.949,
    "end_time": 370.629,
    "duration": 2.680000000000007,
    "timecode": "00:06:07,949 --> 00:06:10,629",
    "is_recovered": false
  },
  {
    "scene_id": 169,
    "text": "증권사들이 목표 주가를 막 올리고 있고요",
    "start_time": 370.629,
    "end_time": 373.709,
    "duration": 3.079999999999984,
    "timecode": "00:06:10,629 --> 00:06:13,709",
    "is_recovered": false
  },
  {
    "scene_id": 170,
    "text": "한국 투자 증권은 180만 원까지 봐요",
    "start_time": 374.23,
    "end_time": 376.949,
    "duration": 2.718999999999994,
    "timecode": "00:06:14,230 --> 00:06:16,949",
    "is_recovered": false
  },
  {
    "scene_id": 171,
    "text": "근데요 리스크도 분명히 있어요",
    "start_time": 377.49,
    "end_time": 379.25,
    "duration": 1.759999999999991,
    "timecode": "00:06:17,490 --> 00:06:19,250",
    "is_recovered": false
  },
  {
    "scene_id": 172,
    "text": "첫 번째 생산 능력이에요",
    "start_time": 379.649,
    "end_time": 381.79,
    "duration": 2.1410000000000196,
    "timecode": "00:06:19,649 --> 00:06:21,790",
    "is_recovered": false
  },
  {
    "scene_id": 173,
    "text": "주문이 너무 많아요",
    "start_time": 381.79,
    "end_time": 383.37,
    "duration": 1.579999999999984,
    "timecode": "00:06:21,790 --> 00:06:23,370",
    "is_recovered": false
  },
  {
    "scene_id": 174,
    "text": "폴란드, 노르웨이, 에스톤이야, 루마니아",
    "start_time": 383.37,
    "end_time": 386.91,
    "duration": 3.5400000000000205,
    "timecode": "00:06:23,370 --> 00:06:26,910",
    "is_recovered": false
  },
  {
    "scene_id": 175,
    "text": "동시에 다 인도해야 해요",
    "start_time": 386.91,
    "end_time": 388.73,
    "duration": 1.8199999999999932,
    "timecode": "00:06:26,910 --> 00:06:28,730",
    "is_recovered": false
  },
  {
    "scene_id": 176,
    "text": "울산 공장 풀가동 해도 빠듯할 수 있어요",
    "start_time": 388.73,
    "end_time": 391.81,
    "duration": 3.079999999999984,
    "timecode": "00:06:28,730 --> 00:06:31,810",
    "is_recovered": false
  },
  {
    "scene_id": 177,
    "text": "폴란드 공장이 빨리 돌아가야 하는 이유가 이거예요",
    "start_time": 391.81,
    "end_time": 394.829,
    "duration": 3.0190000000000055,
    "timecode": "00:06:31,810 --> 00:06:34,829",
    "is_recovered": false
  },
  {
    "scene_id": 178,
    "text": "두 번째 지정하기예요",
    "start_time": 394.829,
    "end_time": 396.90999999999997,
    "duration": 2.0809999999999604,
    "timecode": "00:06:34,829 --> 00:06:36,909",
    "is_recovered": false
  },
  {
    "scene_id": 179,
    "text": "유럽 정세가 또 어떻게 바뀔지 몰라요",
    "start_time": 397.389,
    "end_time": 399.529,
    "duration": 2.1399999999999864,
    "timecode": "00:06:37,389 --> 00:06:39,528",
    "is_recovered": false
  },
  {
    "scene_id": 180,
    "text": "러시아랑 협상이 갑자기 될 수도 있잖아요",
    "start_time": 400.17,
    "end_time": 402.149,
    "duration": 1.978999999999985,
    "timecode": "00:06:40,170 --> 00:06:42,149",
    "is_recovered": false
  },
  {
    "scene_id": 181,
    "text": "그러면 유럽 국가들이 국방비 줄일 수도 있어요",
    "start_time": 402.149,
    "end_time": 404.97,
    "duration": 2.8210000000000264,
    "timecode": "00:06:42,149 --> 00:06:44,970",
    "is_recovered": false
  },
  {
    "scene_id": 182,
    "text": "나토 내부에서 갈등이 생길 수도 있고요",
    "start_time": 404.97,
    "end_time": 407.37,
    "duration": 2.3999999999999773,
    "timecode": "00:06:44,970 --> 00:06:47,370",
    "is_recovered": false
  },
  {
    "scene_id": 183,
    "text": "세 번째 경쟁이에요",
    "start_time": 407.37,
    "end_time": 409.29,
    "duration": 1.920000000000016,
    "timecode": "00:06:47,370 --> 00:06:49,290",
    "is_recovered": false
  },
  {
    "scene_id": 184,
    "text": "미국이 가만히있을까요?",
    "start_time": 409.29,
    "end_time": 410.81,
    "duration": 1.5199999999999818,
    "timecode": "00:06:49,290 --> 00:06:50,810",
    "is_recovered": false
  },
  {
    "scene_id": 185,
    "text": "로키드마틴이 이번에 졌지만 다음에 또 붙어요",
    "start_time": 411.37,
    "end_time": 413.85,
    "duration": 2.480000000000018,
    "timecode": "00:06:51,370 --> 00:06:53,850",
    "is_recovered": false
  },
  {
    "scene_id": 186,
    "text": "유럽 회사들도 방역할 거예요",
    "start_time": 414.23,
    "end_time": 415.709,
    "duration": 1.478999999999985,
    "timecode": "00:06:54,230 --> 00:06:55,709",
    "is_recovered": false
  },
  {
    "scene_id": 187,
    "text": "한화가 계속 이기려면요",
    "start_time": 416.209,
    "end_time": 417.689,
    "duration": 1.4800000000000182,
    "timecode": "00:06:56,209 --> 00:06:57,689",
    "is_recovered": false
  },
  {
    "scene_id": 188,
    "text": "기수도 외교도 계속 앞서가야 해요",
    "start_time": 417.689,
    "end_time": 420.389,
    "duration": 2.6999999999999886,
    "timecode": "00:06:57,689 --> 00:07:00,389",
    "is_recovered": false
  },
  {
    "scene_id": 189,
    "text": "자 오늘 얘기 정리해 볼게요",
    "start_time": 420.389,
    "end_time": 421.829,
    "duration": 1.4399999999999977,
    "timecode": "00:07:00,389 --> 00:07:01,829",
    "is_recovered": false
  },
  {
    "scene_id": 190,
    "text": "한화 여러스페이스가 노르웨이에서",
    "start_time": 422.569,
    "end_time": 424.769,
    "duration": 2.1999999999999886,
    "timecode": "00:07:02,569 --> 00:07:04,769",
    "is_recovered": false
  },
  {
    "scene_id": 191,
    "text": "2조 8천억 수주한 건 단순히 무기판 게 아니에요",
    "start_time": 424.769,
    "end_time": 427.689,
    "duration": 2.920000000000016,
    "timecode": "00:07:04,769 --> 00:07:07,689",
    "is_recovered": false
  },
  {
    "scene_id": 192,
    "text": "나토의 심장부의 한국 무기가 들어간 거예요",
    "start_time": 428.329,
    "end_time": 430.529,
    "duration": 2.1999999999999886,
    "timecode": "00:07:08,329 --> 00:07:10,528",
    "is_recovered": false
  },
  {
    "scene_id": 193,
    "text": "미국 로키드마틴을 정면으로 이기고요",
    "start_time": 430.529,
    "end_time": 432.709,
    "duration": 2.180000000000007,
    "timecode": "00:07:10,528 --> 00:07:12,709",
    "is_recovered": false
  },
  {
    "scene_id": 194,
    "text": "이건 한국 방산 역사의 새로운 장이에요",
    "start_time": 432.709,
    "end_time": 435.149,
    "duration": 2.4399999999999977,
    "timecode": "00:07:12,709 --> 00:07:15,149",
    "is_recovered": false
  },
  {
    "scene_id": 195,
    "text": "K9자주포로 시작해서 천무다연장 로켓으로 확장하고",
    "start_time": 435.85,
    "end_time": 439.089,
    "duration": 3.238999999999976,
