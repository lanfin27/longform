[
  {
    "scene_id": 1,
    "text": "여러분, 은행 다닌다고 하면 뭐가 떠오르세요?",
    "start_time": 0.23,
    "end_time": 2.71,
    "duration": 2.48,
    "timecode": "00:00:00,230 --> 00:00:02,710",
    "is_recovered": false
  },
  {
    "scene_id": 2,
    "text": "안정적인 직장, 철밥통, 부모님이 좋아하는 직업?",
    "start_time": 3.25,
    "end_time": 6.91,
    "duration": 3.66,
    "timecode": "00:00:03,250 --> 00:00:06,910",
    "is_recovered": false
  },
  {
    "scene_id": 3,
    "text": "근데요, 지금 은행에서 무슨 일이 벌어지고 있는지 아세요?",
    "start_time": 7.349,
    "end_time": 10.369,
    "duration": 3.0199999999999996,
    "timecode": "00:00:07,349 --> 00:00:10,368",
    "is_recovered": false
  },
  {
    "scene_id": 4,
    "text": "40대 은행원들이 줄줄이 나가고 있어요",
    "start_time": 10.849,
    "end_time": 12.949,
    "duration": 2.0999999999999996,
    "timecode": "00:00:10,849 --> 00:00:12,948",
    "is_recovered": false
  },
  {
    "scene_id": 5,
    "text": "스스로요, 자발적으로",
    "start_time": 13.509,
    "end_time": 15.189,
    "duration": 1.6799999999999997,
    "timecode": "00:00:13,509 --> 00:00:15,189",
    "is_recovered": false
  },
  {
    "scene_id": 6,
    "text": "2025년부터 2026년까지 5대 시중은행에서 퇴직한 사람이 2364명이에요",
    "start_time": 16.449,
    "end_time": 21.929,
    "duration": 5.479999999999997,
    "timecode": "00:00:16,449 --> 00:00:21,928",
    "is_recovered": false
  },
  {
    "scene_id": 7,
    "text": "근데 이게 왜 충격적이냐면요",
    "start_time": 21.929,
    "end_time": 24.149,
    "duration": 2.2200000000000024,
    "timecode": "00:00:21,928 --> 00:00:24,149",
    "is_recovered": false
  },
  {
    "scene_id": 8,
    "text": "은행들이 지금 역대급으로 돈을 벌고 있거든요",
    "start_time": 24.149,
    "end_time": 26.629,
    "duration": 2.4800000000000004,
    "timecode": "00:00:24,149 --> 00:00:26,629",
    "is_recovered": false
  },
  {
    "scene_id": 9,
    "text": "2025년 3분기까지 순위익이 21조 원이에요",
    "start_time": 27.149,
    "end_time": 30.25,
    "duration": 3.100999999999999,
    "timecode": "00:00:27,149 --> 00:00:30,250",
    "is_recovered": false
  },
  {
    "scene_id": 10,
    "text": "사상 최고치에요",
    "start_time": 30.25,
    "end_time": 31.769,
    "duration": 1.5189999999999984,
    "timecode": "00:00:30,250 --> 00:00:31,768",
    "is_recovered": false
  },
  {
    "scene_id": 11,
    "text": "돈을 이렇게 잘 버는데 왜 사람을 내보내는 걸까요?",
    "start_time": 31.769,
    "end_time": 35.03,
    "duration": 3.261000000000003,
    "timecode": "00:00:31,768 --> 00:00:35,030",
    "is_recovered": false
  },
  {
    "scene_id": 12,
    "text": "저도 이번에 자료 보면서 좀 놀랐어요",
    "start_time": 35.609,
    "end_time": 37.469,
    "duration": 1.8599999999999994,
    "timecode": "00:00:35,609 --> 00:00:37,469",
    "is_recovered": false
  },
  {
    "scene_id": 13,
    "text": "은행의 미래가 이렇게 바뀌는구나?",
    "start_time": 37.469,
    "end_time": 39.59,
    "duration": 2.121000000000002,
    "timecode": "00:00:37,469 --> 00:00:39,590",
    "is_recovered": false
  },
  {
    "scene_id": 14,
    "text": "이런 생각이 들더라고요",
    "start_time": 40.03,
    "end_time": 40.969,
    "duration": 0.9390000000000001,
    "timecode": "00:00:40,030 --> 00:00:40,969",
    "is_recovered": false
  },
  {
    "scene_id": 15,
    "text": "자, 그럼 시작해볼게요",
    "start_time": 41.34,
    "end_time": 42.81,
    "duration": 1.4699999999999989,
    "timecode": "00:00:41,340 --> 00:00:42,810",
    "is_recovered": false
  },
  {
    "scene_id": 16,
    "text": "일단 상황부터 깔고 가야 해요",
    "start_time": 43.179,
    "end_time": 44.969,
    "duration": 1.7899999999999991,
    "timecode": "00:00:43,179 --> 00:00:44,969",
    "is_recovered": false
  },
  {
    "scene_id": 17,
    "text": "지금 은행들이 얼마나 돈을 잘 버는지 아시는 분 계세요?",
    "start_time": 44.969,
    "end_time": 47.81,
    "duration": 2.841000000000001,
    "timecode": "00:00:44,969 --> 00:00:47,810",
    "is_recovered": false
  },
  {
    "scene_id": 18,
    "text": "2025년 3분기 기준으로요",
    "start_time": 48.289,
    "end_time": 50.549,
    "duration": 2.259999999999998,
    "timecode": "00:00:48,289 --> 00:00:50,548",
    "is_recovered": false
  },
  {
    "scene_id": 19,
    "text": "전체 은행권 순위익이 21조 원을 돌파했어요",
    "start_time": 50.549,
    "end_time": 53.549,
    "duration": 3.0,
    "timecode": "00:00:50,548 --> 00:00:53,548",
    "is_recovered": false
  },
  {
    "scene_id": 20,
    "text": "전년대비 2조 3000억 원이 늘어난 거예요",
    "start_time": 53.549,
    "end_time": 56.07,
    "duration": 2.521000000000001,
    "timecode": "00:00:53,548 --> 00:00:56,070",
    "is_recovered": false
  },
  {
    "scene_id": 21,
    "text": "KB 국민, 신한 하나, 우리 농협",
    "start_time": 56.07,
    "end_time": 58.45,
    "duration": 2.3800000000000026,
    "timecode": "00:00:56,070 --> 00:00:58,450",
    "is_recovered": false
  },
  {
    "scene_id": 22,
    "text": "다 돈을 쓸어 담고 있어요",
    "start_time": 58.45,
    "end_time": 59.99,
    "duration": 1.5399999999999991,
    "timecode": "00:00:58,450 --> 00:00:59,990",
    "is_recovered": false
  },
  {
    "scene_id": 23,
    "text": "근데요, 바로 이 시점에 무슨 일이 벌어졌냐면요",
    "start_time": 59.99,
    "end_time": 63.45,
    "duration": 3.460000000000001,
    "timecode": "00:00:59,990 --> 00:01:03,450",
    "is_recovered": false
  },
  {
    "scene_id": 24,
    "text": "대규모 희망 퇴직이 터진 거예요",
    "start_time": 63.45,
    "end_time": 65.01,
    "duration": 1.5600000000000023,
    "timecode": "00:01:03,450 --> 00:01:05,010",
    "is_recovered": false
  },
  {
    "scene_id": 25,
    "text": "이게 좀 이상하지 않아요?",
    "start_time": 65.39,
    "end_time": 66.469,
    "duration": 1.0789999999999935,
    "timecode": "00:01:05,390 --> 00:01:06,468",
    "is_recovered": false
  },
  {
    "scene_id": 26,
    "text": "보통 구조조정이라고 하면 회사가 어려울 때 하잖아요?",
    "start_time": 67.049,
    "end_time": 69.909,
    "duration": 2.8599999999999994,
    "timecode": "00:01:07,049 --> 00:01:09,909",
    "is_recovered": false
  },
  {
    "scene_id": 27,
    "text": "근데 은행들은 역대급으로 돈 벌면서 사람을 내보내는 거예요",
    "start_time": 70.349,
    "end_time": 73.23,
    "duration": 2.8810000000000002,
    "timecode": "00:01:10,349 --> 00:01:13,230",
    "is_recovered": false
  },
  {
    "scene_id": 28,
    "text": "왜 그럴까요?",
    "start_time": 73.23,
    "end_time": 74.01,
    "duration": 0.7800000000000011,
    "timecode": "00:01:13,230 --> 00:01:14,010",
    "is_recovered": false
  },
  {
    "scene_id": 29,
    "text": "이유는 하나예요",
    "start_time": 74.59,
    "end_time": 75.59,
    "duration": 1.0,
    "timecode": "00:01:14,590 --> 00:01:15,590",
    "is_recovered": false
  },
  {
    "scene_id": 30,
    "text": "미래가 보이기 때문이에요",
    "start_time": 75.59,
    "end_time": 77.09,
    "duration": 1.5,
    "timecode": "00:01:15,590 --> 00:01:17,090",
    "is_recovered": false
  },
  {
    "scene_id": 31,
    "text": "금리 인화가 시작되면요",
    "start_time": 77.09,
    "end_time": 79.01,
    "duration": 1.9200000000000017,
    "timecode": "00:01:17,090 --> 00:01:19,010",
    "is_recovered": false
  },
  {
    "scene_id": 32,
    "text": "은행의 핵심 수익인 이자마진이 쪼그라들어요",
    "start_time": 79.01,
    "end_time": 81.39,
    "duration": 2.3799999999999955,
    "timecode": "00:01:19,010 --> 00:01:21,390",
    "is_recovered": false
  },
  {
    "scene_id": 33,
    "text": "지금 벌 때 벌어놓고 고정비를 확 줄여놓자는 거죠",
    "start_time": 81.39,
    "end_time": 84.73,
    "duration": 3.3400000000000034,
    "timecode": "00:01:21,390 --> 00:01:24,730",
    "is_recovered": false
  },
  {
    "scene_id": 34,
    "text": "그리고 더 무서운 게 있어요",
    "start_time": 84.73,
    "end_time": 86.209,
    "duration": 1.4789999999999992,
    "timecode": "00:01:24,730 --> 00:01:26,209",
    "is_recovered": false
  },
  {
    "scene_id": 35,
    "text": "AI가 은행원 자리를 대체하기 시작했거든요",
    "start_time": 86.209,
    "end_time": 89.15,
    "duration": 2.9410000000000025,
    "timecode": "00:01:26,209 --> 00:01:29,150",
    "is_recovered": false
  },
  {
    "scene_id": 36,
    "text": "자, 이게 핵심이에요",
    "start_time": 89.15,
    "end_time": 90.53,
    "duration": 1.3799999999999955,
    "timecode": "00:01:29,150 --> 00:01:30,530",
    "is_recovered": false
  },
  {
    "scene_id": 37,
    "text": "집중하셔야 해요",
    "start_time": 90.53,
    "end_time": 91.45,
    "duration": 0.9200000000000017,
    "timecode": "00:01:30,530 --> 00:01:31,450",
    "is_recovered": false
  },
  {
    "scene_id": 38,
    "text": "신한은행이 뭘 했냐면요",
    "start_time": 91.45,
    "end_time": 93.15,
    "duration": 1.7000000000000028,
    "timecode": "00:01:31,450 --> 00:01:33,150",
    "is_recovered": false
  },
  {
    "scene_id": 39,
    "text": "AI 뱅커가 탑재된 무인 점포를 열었어요",
    "start_time": 93.15,
    "end_time": 95.65,
    "duration": 2.5,
    "timecode": "00:01:33,150 --> 00:01:35,650",
    "is_recovered": false
  },
  {
    "scene_id": 40,
    "text": "이름이 AI 브랜치예요",
    "start_time": 95.65,
    "end_time": 97.15,
    "duration": 1.5,
    "timecode": "00:01:35,650 --> 00:01:37,150",
    "is_recovered": false
  },
  {
    "scene_id": 41,
    "text": "여기서 뭘 할 수 있냐면요",
    "start_time": 97.15,
    "end_time": 98.65,
    "duration": 1.5,
    "timecode": "00:01:37,150 --> 00:01:38,650",
    "is_recovered": false
  },
  {
    "scene_id": 42,
    "text": "계좌 개설, 증명서 발급, 대출 상담",
    "start_time": 98.65,
    "end_time": 101.53,
    "duration": 2.8799999999999955,
    "timecode": "00:01:38,650 --> 00:01:41,530",
    "is_recovered": false
  },
  {
    "scene_id": 43,
    "text": "무려 64개의 창구 업무를 AI가 다 처리해요",
    "start_time": 101.53,
    "end_time": 104.989,
    "duration": 3.459000000000003,
    "timecode": "00:01:41,530 --> 00:01:44,989",
    "is_recovered": false
  },
  {
    "scene_id": 44,
    "text": "사람 없이요?",
    "start_time": 104.989,
    "end_time": 106.10900000000001,
    "duration": 1.1200000000000045,
    "timecode": "00:01:44,989 --> 00:01:46,109",
    "is_recovered": false
  },
  {
    "scene_id": 45,
    "text": "NH 농협은행은요",
    "start_time": 106.469,
    "end_time": 108.12899999999999,
    "duration": 1.6599999999999966,
    "timecode": "00:01:46,468 --> 00:01:48,128",
    "is_recovered": false
  },
  {
    "scene_id": 46,
    "text": "전국 113개 모든 영업점에 AI 뱅커를 깔았어요",
    "start_time": 108.12899999999999,
    "end_time": 112.40899999999999,
    "duration": 4.280000000000001,
    "timecode": "00:01:48,128 --> 00:01:52,408",
    "is_recovered": false
  },
  {
    "scene_id": 47,
    "text": "투자 상품 설명하고, 고객 응대하고",
    "start_time": 112.739,
    "end_time": 115.40899999999999,
    "duration": 2.6699999999999875,
    "timecode": "00:01:52,739 --> 00:01:55,408",
    "is_recovered": false
  },
  {
    "scene_id": 48,
    "text": "예전에는 사람이 하던 일이에요",
    "start_time": 115.40899999999999,
    "end_time": 117.45,
    "duration": 2.041000000000011,
    "timecode": "00:01:55,408 --> 00:01:57,450",
    "is_recovered": false
  },
  {
    "scene_id": 49,
    "text": "KB 국민은행, 우리 은행도 마찬가지예요",
    "start_time": 117.45,
    "end_time": 120.769,
    "duration": 3.3190000000000026,
    "timecode": "00:01:57,450 --> 00:02:00,769",
    "is_recovered": false
  },
  {
    "scene_id": 50,
    "text": "AI 금융비서가 대출 상담하고, 상품 추천해요",
    "start_time": 120.769,
    "end_time": 124.37,
    "duration": 3.600999999999999,
    "timecode": "00:02:00,769 --> 00:02:04,370",
    "is_recovered": false
  },
  {
    "scene_id": 51,
    "text": "이게 무슨 의미이냐면요",
    "start_time": 124.37,
    "end_time": 126.01,
    "duration": 1.6400000000000006,
    "timecode": "00:02:04,370 --> 00:02:06,010",
    "is_recovered": false
  },
  {
    "scene_id": 52,
    "text": "은행 창구에 앉아서 고객 응대하던 그 일",
    "start_time": 126.01,
    "end_time": 128.43,
    "duration": 2.4200000000000017,
    "timecode": "00:02:06,010 --> 00:02:08,430",
    "is_recovered": false
  },
  {
    "scene_id": 53,
    "text": "이제 AI가 한다는 거예요",
    "start_time": 128.43,
    "end_time": 130.22899999999998,
    "duration": 1.7989999999999782,
    "timecode": "00:02:08,430 --> 00:02:10,228",
    "is_recovered": false
  },
  {
    "scene_id": 54,
    "text": "자, 그러면 은행들이 얼마나 사람을 내보냈는지 볼게요",
    "start_time": 130.22899999999998,
    "end_time": 133.27,
    "duration": 3.0410000000000252,
    "timecode": "00:02:10,228 --> 00:02:13,270",
    "is_recovered": false
  },
  {
    "scene_id": 55,
    "text": "2025년말부터 2026년 초까지",
    "start_time": 133.81,
    "end_time": 136.37,
    "duration": 2.5600000000000023,
    "timecode": "00:02:13,810 --> 00:02:16,370",
    "is_recovered": false
  },
  {
    "scene_id": 56,
    "text": "5대 시중은행 희망 퇴직자 총 2364명이에요",
    "start_time": 136.37,
    "end_time": 140.32999999999998,
    "duration": 3.9599999999999795,
    "timecode": "00:02:16,370 --> 00:02:20,329",
    "is_recovered": false
  },
  {
    "scene_id": 57,
    "text": "은행별로 보면요",
    "start_time": 140.32999999999998,
    "end_time": 141.93,
    "duration": 1.6000000000000227,
    "timecode": "00:02:20,329 --> 00:02:21,930",
    "is_recovered": false
  },
  {
    "scene_id": 58,
    "text": "신화는행이 669명으로 가장 많아요",
    "start_time": 141.93,
    "end_time": 145.129,
    "duration": 3.198999999999984,
    "timecode": "00:02:21,930 --> 00:02:25,128",
    "is_recovered": false
  },
  {
    "scene_id": 59,
    "text": "전년보다 128명이나 늘었어요",
    "start_time": 145.129,
    "end_time": 147.77,
    "duration": 2.6410000000000196,
    "timecode": "00:02:25,128 --> 00:02:27,770",
    "is_recovered": false
  },
  {
    "scene_id": 60,
    "text": "KB 국민은행 549명",
    "start_time": 147.77,
    "end_time": 150.069,
    "duration": 2.298999999999978,
    "timecode": "00:02:27,770 --> 00:02:30,068",
    "is_recovered": false
  },
  {
    "scene_id": 61,
    "text": "NH 농협은행 443명",
    "start_time": 150.069,
    "end_time": 152.889,
    "duration": 2.8200000000000216,
    "timecode": "00:02:30,068 --> 00:02:32,889",
    "is_recovered": false
  },
  {
    "scene_id": 62,
    "text": "우리 은행 420명",
    "start_time": 152.889,
    "end_time": 154.61,
    "duration": 1.7210000000000036,
    "timecode": "00:02:32,889 --> 00:02:34,610",
    "is_recovered": false
  },
  {
    "scene_id": 63,
    "text": "하나은행 283명",
    "start_time": 154.61,
    "end_time": 156.449,
    "duration": 1.8389999999999986,
    "timecode": "00:02:34,610 --> 00:02:36,449",
    "is_recovered": false
  },
  {
    "scene_id": 64,
    "text": "근데요, 진짜 충격적인 건 따로 있어요",
    "start_time": 156.449,
    "end_time": 158.81,
    "duration": 2.36099999999999,
    "timecode": "00:02:36,449 --> 00:02:38,810",
    "is_recovered": false
  },
  {
    "scene_id": 65,
    "text": "예전에는 희망 퇴직 대상이 누구였냐면요",
    "start_time": 158.81,
    "end_time": 161.349,
    "duration": 2.5389999999999873,
    "timecode": "00:02:38,810 --> 00:02:41,348",
    "is_recovered": false
  },
  {
    "scene_id": 66,
    "text": "50대 후반이요",
    "start_time": 161.349,
